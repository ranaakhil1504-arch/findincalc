---
// src/pages/finance/emi.astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import SEOContent from '../../components/SEOContent.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
---

<Layout title="EMI Calculator - Equated Monthly Installment Calculator">
  <Navbar />

  <main class="pt-8 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-8 fade-in fade-in-delay-1">
        <span class="text-5xl">📈</span>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mt-2">
          EMI Calculator
        </h1>
        <p class="text-gray-600 dark:text-gray-400">
          Calculate your Equated Monthly Installment for any loan
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
        <!-- Left: Calculator -->
        <div class="lg:col-span-3">
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-4 sm:p-6 border border-gray-200 dark:border-gray-700">
            
            <!-- Mode Toggle -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
              <label class="text-sm font-medium text-gray-700 dark:text-gray-300 min-w-[100px]">
                Mode
              </label>
              <div class="flex flex-wrap gap-2">
                <button 
                  id="modeEMI"
                  class="emi-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25"
                >
                  📊 Find EMI
                </button>
                <button 
                  id="modeLoanAmount"
                  class="emi-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600"
                >
                  💰 Find Loan Amount
                </button>
                <button 
                  id="modeTenure"
                  class="emi-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600"
                >
                  📅 Find Tenure
                </button>
              </div>
            </div>

            <!-- Inputs -->
            <div class="space-y-4">
              <!-- Loan Amount -->
              <div>
                <div class="flex justify-between items-center mb-2">
                  <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                    Loan Amount = <span id="loanAmountDisplay" class="text-emerald-600 font-bold">500,000</span>
                  </label>
                </div>
                <input 
                  type="range" 
                  id="loanAmountSlider"
                  class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                  min="1000"
                  max="10000000"
                  step="any"
                  value="500000"
                />
                <div class="flex justify-between text-xs text-gray-400 mt-1">
                  <span>$1,000</span>
                  <span>$10,000,000</span>
                </div>
                <input 
                  type="number" 
                  id="loanAmountInput"
                  class="w-full mt-2 px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                  placeholder="Loan Amount"
                  value="500000"
                  step="any"
                  min="1000"
                />
              </div>

              <!-- Interest Rate -->
              <div>
                <div class="flex justify-between items-center mb-2">
                  <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                    Interest Rate = <span id="interestDisplay" class="text-emerald-600 font-bold">7</span>%
                  </label>
                </div>
                <input 
                  type="range" 
                  id="interestSlider"
                  class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                  min="1"
                  max="30"
                  step="any"
                  value="7"
                />
                <div class="flex justify-between text-xs text-gray-400 mt-1">
                  <span>1%</span>
                  <span>30%</span>
                </div>
                <input 
                  type="number" 
                  id="interestInput"
                  class="w-full mt-2 px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                  placeholder="Interest Rate"
                  value="7"
                  step="any"
                  min="1"
                  max="30"
                />
              </div>

              <!-- Tenure -->
              <div>
                <div class="flex justify-between items-center mb-2">
                  <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                    Tenure = <span id="tenureDisplay" class="text-emerald-600 font-bold">5</span> years
                  </label>
                </div>
                <input 
                  type="range" 
                  id="tenureSlider"
                  class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                  min="1"
                  max="30"
                  step="1"
                  value="5"
                />
                <div class="flex justify-between text-xs text-gray-400 mt-1">
                  <span>1 year</span>
                  <span>30 years</span>
                </div>
                <input 
                  type="number" 
                  id="tenureInput"
                  class="w-full mt-2 px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                  placeholder="Tenure (years)"
                  value="5"
                  step="1"
                  min="1"
                  max="30"
                />
              </div>

              <button 
                id="emiCalculateBtn"
                class="btn-primary w-full text-center"
              >
                Calculate EMI
              </button>
            </div>

            <!-- EMI Result Box -->
            <div id="emiResultBox" class="mt-6 rounded-xl p-4 border border-emerald-500 bg-emerald-50 dark:bg-emerald-900/20 hidden">
              <div class="grid grid-cols-3 gap-4 text-center">
                <div>
                  <p class="text-xs text-gray-600 dark:text-gray-400">Monthly EMI</p>
                  <p class="text-2xl font-bold text-emerald-600 dark:text-emerald-400" id="monthlyEMI">$0</p>
                </div>
                <div>
                  <p class="text-xs text-gray-600 dark:text-gray-400">Total Interest</p>
                  <p class="text-2xl font-bold text-amber-600 dark:text-amber-400" id="totalInterest">$0</p>
                </div>
                <div>
                  <p class="text-xs text-gray-600 dark:text-gray-400">Total Payment</p>
                  <p class="text-2xl font-bold text-blue-600 dark:text-blue-400" id="totalPayment">$0</p>
                </div>
              </div>

              <!-- EMI Breakdown -->
              <div class="mt-4 grid grid-cols-2 gap-3">
                <div class="p-3 rounded-lg bg-white/50 dark:bg-gray-700/50 text-center">
                  <p class="text-xs text-gray-500 dark:text-gray-400">Principal</p>
                  <p class="text-sm font-bold text-gray-700 dark:text-gray-300" id="principalAmount">$0</p>
                </div>
                <div class="p-3 rounded-lg bg-white/50 dark:bg-gray-700/50 text-center">
                  <p class="text-xs text-gray-500 dark:text-gray-400">Total Interest %</p>
                  <p class="text-sm font-bold text-amber-600 dark:text-amber-400" id="interestPercentage">0%</p>
                </div>
              </div>
            </div>

            <!-- Disclaimer -->
            <div class="mt-4 p-4 rounded-xl bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700">
              <p class="text-xs text-gray-500 dark:text-gray-400">
                ⚠️ <span class="font-medium">Disclaimer:</span> EMI calculations are estimates. Actual loan terms may vary. Consult your lender for exact figures.
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Information -->
        <div class="lg:col-span-2 space-y-4">
          <!-- EMI Formula -->
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-3">📐 EMI Formula</h3>
            <div class="bg-gray-100 dark:bg-gray-700 rounded-xl p-4 text-center">
              <p class="text-xl font-mono text-gray-800 dark:text-gray-200">EMI = P × r × (1+r)ⁿ / ((1+r)ⁿ - 1)</p>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">P = Loan Amount, r = Monthly Rate, n = Months</p>
            </div>
            <div class="mt-4 space-y-2 text-sm text-gray-600 dark:text-gray-400">
              <div class="flex justify-between border-b border-gray-100 dark:border-gray-700 pb-2">
                <span>Monthly EMI</span>
                <span class="font-mono" id="formulaEMI">$0</span>
              </div>
              <div class="flex justify-between border-b border-gray-100 dark:border-gray-700 pb-2">
                <span>Total Interest</span>
                <span class="font-mono" id="formulaInterest">$0</span>
              </div>
              <div class="flex justify-between font-bold text-emerald-600 dark:text-emerald-400 pt-1">
                <span>Total Payment</span>
                <span class="font-mono" id="formulaTotal">$0</span>
              </div>
            </div>
          </div>

          <!-- EMI Summary -->
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-3">📋 Loan Summary</h3>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between border-b border-gray-100 dark:border-gray-700 pb-2">
                <span class="text-gray-600 dark:text-gray-400">Loan Amount</span>
                <span class="font-bold text-gray-900 dark:text-white" id="summaryAmount">$500,000</span>
              </div>
              <div class="flex justify-between border-b border-gray-100 dark:border-gray-700 pb-2">
                <span class="text-gray-600 dark:text-gray-400">Interest Rate</span>
                <span class="font-bold text-gray-900 dark:text-white" id="summaryRate">7%</span>
              </div>
              <div class="flex justify-between border-b border-gray-100 dark:border-gray-700 pb-2">
                <span class="text-gray-600 dark:text-gray-400">Tenure</span>
                <span class="font-bold text-gray-900 dark:text-white" id="summaryTenure">5 years</span>
              </div>
              <div class="flex justify-between border-b border-gray-100 dark:border-gray-700 pb-2">
                <span class="text-gray-600 dark:text-gray-400">Total Months</span>
                <span class="font-bold text-gray-900 dark:text-white" id="summaryMonths">60</span>
              </div>
            </div>
          </div>

          <!-- Step-by-Step -->
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-3">📝 Step-by-Step</h3>
            <div class="space-y-2 text-sm">
              <div class="flex items-start gap-3 p-2 rounded-lg bg-gray-50 dark:bg-gray-700/50">
                <span class="text-emerald-500 font-bold min-w-[24px]">1.</span>
                <span class="text-gray-600 dark:text-gray-400" id="step1">Convert annual rate to monthly: 7% / 12 = 0.00583</span>
              </div>
              <div class="flex items-start gap-3 p-2 rounded-lg bg-gray-50 dark:bg-gray-700/50">
                <span class="text-emerald-500 font-bold min-w-[24px]">2.</span>
                <span class="text-gray-600 dark:text-gray-400" id="step2">Calculate number of months: 5 × 12 = 60</span>
              </div>
              <div class="flex items-start gap-3 p-2 rounded-lg bg-gray-50 dark:bg-gray-700/50">
                <span class="text-emerald-500 font-bold min-w-[24px]">3.</span>
                <span class="text-gray-600 dark:text-gray-400" id="step3">Apply EMI formula: 500,000 × 0.00583 × (1.00583)^60 / ((1.00583)^60 - 1)</span>
              </div>
              <div class="flex items-start gap-3 p-3 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800">
                <span class="text-emerald-600 dark:text-emerald-400 font-bold min-w-[24px]">✓</span>
                <span class="font-bold text-emerald-600 dark:text-emerald-400" id="step4">Result: Monthly EMI = $9,900.50</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SEO Content -->
      <SEOContent 
        title="What is an EMI Calculator?"
        description="An EMI (Equated Monthly Installment) calculator helps you estimate your monthly loan payments. Plan your finances with accurate EMI calculations."
        formula="EMI = P × r × (1+r)ⁿ / ((1+r)ⁿ - 1)"
        formulaDescription="P = Loan Amount, r = Monthly Interest Rate, n = Number of Months"
        example={{
          title: "Example: Calculate EMI for a $500,000 loan at 7% interest for 5 years",
          steps: [
            "Monthly rate: 7% / 12 = 0.00583",
            "Months: 5 × 12 = 60",
            "EMI = 500,000 × 0.00583 × (1.00583)^60 / ((1.00583)^60 - 1)"
          ],
          result: "Monthly EMI: $9,900.50 | Total Interest: $94,030 | Total Payment: $594,030"
        }}
        uses={[
          "Home Loans: Calculate mortgage EMI before buying",
          "Car Loans: Plan auto loan payments",
          "Personal Loans: Estimate monthly installments",
          "Financial Planning: Compare loan offers"
        ]}
        faqs={[
          {
            question: "What is EMI?",
            answer: "EMI (Equated Monthly Installment) is a fixed payment amount made by a borrower to a lender at a specified date each calendar month."
          },
          {
            question: "What factors affect EMI?",
            answer: "EMI depends on three factors: loan amount, interest rate, and loan tenure. Higher amounts or rates increase EMI, longer tenure decreases it."
          },
          {
            question: "Can I reduce my EMI?",
            answer: "Yes, by increasing the loan tenure (more months) or securing a lower interest rate. However, longer tenure means more total interest paid."
          }
        ]}
        note="EMI calculations are estimates. Actual loan terms may vary based on lender policies and fees."
      />

      <!-- Related Calculators -->
      <RelatedCalculators currentId="emi" />
    </div>
  </main>

  <script>
    import { validatePositiveNumber } from '../../lib/calculator/validation';
    import { formatNumber, formatResult, formatDecimal } from '../../lib/calculator/formatting';
    
    document.addEventListener('DOMContentLoaded', () => {
      // ============================================
      // STATE
      // ============================================
      let currentMode = 'emi';
      let rawAmount = 500000;
      let rawRate = 7;
      let rawTenure = 5;

      // ============================================
      // VALIDATION HELPERS
      // ============================================
      function validatePositive(value, name, maxVal) {
        const result = validatePositiveNumber(value, name, maxVal);
        if (!result.valid) {
          return { valid: false, message: result.message };
        }
        return { valid: true, value: result.value };
      }

      function setSliderValue(slider, value, defaultMax) {
        const num = Number(value);
        if (!Number.isFinite(num)) return;
        if (defaultMax !== undefined) slider.max = String(Math.max(defaultMax, num));
        slider.value = String(num);
      }

      function formatCurrency(value) {
        return '$' + formatNumber(value, { 
          maximumFractionDigits: 2,
          minimumFractionDigits: 2,
          useGrouping: true
        });
      }

      // ============================================
      // DOM REFERENCES
      // ============================================
      const loanAmountSlider = document.getElementById('loanAmountSlider');
      const interestSlider = document.getElementById('interestSlider');
      const tenureSlider = document.getElementById('tenureSlider');
      const loanAmountInput = document.getElementById('loanAmountInput');
      const interestInput = document.getElementById('interestInput');
      const tenureInput = document.getElementById('tenureInput');
      const loanAmountDisplay = document.getElementById('loanAmountDisplay');
      const interestDisplay = document.getElementById('interestDisplay');
      const tenureDisplay = document.getElementById('tenureDisplay');
      const monthlyEMI = document.getElementById('monthlyEMI');
      const totalInterest = document.getElementById('totalInterest');
      const totalPayment = document.getElementById('totalPayment');
      const principalAmount = document.getElementById('principalAmount');
      const interestPercentage = document.getElementById('interestPercentage');
      const formulaEMI = document.getElementById('formulaEMI');
      const formulaInterest = document.getElementById('formulaInterest');
      const formulaTotal = document.getElementById('formulaTotal');
      const summaryAmount = document.getElementById('summaryAmount');
      const summaryRate = document.getElementById('summaryRate');
      const summaryTenure = document.getElementById('summaryTenure');
      const summaryMonths = document.getElementById('summaryMonths');
      const emiResultBox = document.getElementById('emiResultBox');
      const step1 = document.getElementById('step1');
      const step2 = document.getElementById('step2');
      const step3 = document.getElementById('step3');
      const step4 = document.getElementById('step4');

      function showValidationError(message) {
        if (window.showToast) window.showToast(message, 'error');
        else window.alert(message);
      }

      // ============================================
      // CALCULATE EMI
      // ============================================
      function calculateEMI(syncInputs = true) {
        let amount = rawAmount;
        let rate = rawRate;
        let tenure = rawTenure;

        const monthlyRate = rate / 100 / 12;
        const months = tenure * 12;

        // Update displays
        loanAmountDisplay.textContent = formatNumber(amount, { useGrouping: true, maximumFractionDigits: 0 });
        interestDisplay.textContent = formatNumber(rate, { maximumFractionDigits: 1 });
        tenureDisplay.textContent = formatNumber(tenure, { maximumFractionDigits: 0 });

        // Calculate EMI
        let emi, totalInterestAmount, totalPaymentAmount;
        
        if (amount === 0) {
          emi = 0;
          totalInterestAmount = 0;
          totalPaymentAmount = 0;
        } else if (monthlyRate === 0 || rate === 0) {
          emi = amount / months;
          totalInterestAmount = 0;
          totalPaymentAmount = amount;
        } else {
          const factor = Math.pow(1 + monthlyRate, months);
          emi = amount * monthlyRate * factor / (factor - 1);
          totalPaymentAmount = emi * months;
          totalInterestAmount = totalPaymentAmount - amount;
        }

        // Calculate interest percentage
        const interestPercent = totalPaymentAmount > 0 ? (totalInterestAmount / totalPaymentAmount) * 100 : 0;

        // Update results
        monthlyEMI.textContent = formatCurrency(emi);
        totalInterest.textContent = formatCurrency(totalInterestAmount);
        totalPayment.textContent = formatCurrency(totalPaymentAmount);
        principalAmount.textContent = formatCurrency(amount);
        interestPercentage.textContent = formatNumber(interestPercent, { maximumFractionDigits: 1 }) + '%';
        
        // Update formula
        formulaEMI.textContent = formatCurrency(emi);
        formulaInterest.textContent = formatCurrency(totalInterestAmount);
        formulaTotal.textContent = formatCurrency(totalPaymentAmount);

        // Update summary
        summaryAmount.textContent = formatCurrency(amount);
        summaryRate.textContent = formatNumber(rate, { maximumFractionDigits: 1 }) + '%';
        summaryTenure.textContent = formatNumber(tenure, { maximumFractionDigits: 0 }) + ' year' + (tenure > 1 ? 's' : '');
        summaryMonths.textContent = formatNumber(months, { maximumFractionDigits: 0 });

        // Update steps
        step1.textContent = `Convert annual rate to monthly: ${formatNumber(rate, { maximumFractionDigits: 1 })}% / 12 = ${formatNumber(monthlyRate, { maximumFractionDigits: 5 })}`;
        step2.textContent = `Calculate number of months: ${formatNumber(tenure, { maximumFractionDigits: 0 })} × 12 = ${formatNumber(months, { maximumFractionDigits: 0 })}`;
        step3.textContent = `Apply EMI formula: ${formatCurrency(amount)} × ${formatNumber(monthlyRate, { maximumFractionDigits: 5 })} × (1.${formatNumber(monthlyRate, { maximumFractionDigits: 5 })})^${formatNumber(months, { maximumFractionDigits: 0 })} / ((1.${formatNumber(monthlyRate, { maximumFractionDigits: 5 })})^${formatNumber(months, { maximumFractionDigits: 0 })} - 1)`;
        step4.textContent = `Result: Monthly EMI = ${formatCurrency(emi)}`;

        // Show results if amount > 0
        if (amount > 0) {
          emiResultBox.classList.remove('hidden');
        } else {
          emiResultBox.classList.add('hidden');
        }

        if (syncInputs) {
          loanAmountSlider.value = amount;
          interestSlider.value = rate;
          tenureSlider.value = tenure;
          loanAmountInput.value = amount;
          interestInput.value = rate;
          tenureInput.value = tenure;
        }
      }

      // ============================================
      // MODE TOGGLE
      // ============================================
      document.getElementById('modeEMI').addEventListener('click', () => {
        document.querySelectorAll('.emi-mode-btn').forEach(b => {
          b.className = 'emi-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600';
        });
        document.getElementById('modeEMI').className = 'emi-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25';
        currentMode = 'emi';
        calculateEMI();
      });

      document.getElementById('modeLoanAmount').addEventListener('click', () => {
        document.querySelectorAll('.emi-mode-btn').forEach(b => {
          b.className = 'emi-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600';
        });
        document.getElementById('modeLoanAmount').className = 'emi-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25';
        currentMode = 'loanAmount';
        // For now, just use same calculation
        calculateEMI();
      });

      document.getElementById('modeTenure').addEventListener('click', () => {
        document.querySelectorAll('.emi-mode-btn').forEach(b => {
          b.className = 'emi-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600';
        });
        document.getElementById('modeTenure').className = 'emi-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25';
        currentMode = 'tenure';
        calculateEMI();
      });

      // ============================================
      // SLIDER EVENTS
      // ============================================
      loanAmountSlider.addEventListener('input', () => {
        rawAmount = parseFloat(loanAmountSlider.value);
        calculateEMI();
      });
      interestSlider.addEventListener('input', () => {
        rawRate = parseFloat(interestSlider.value);
        calculateEMI();
      });
      tenureSlider.addEventListener('input', () => {
        rawTenure = parseFloat(tenureSlider.value);
        calculateEMI();
      });

      // ============================================
      // INPUT EVENTS
      // ============================================
      loanAmountInput.addEventListener('input', () => {
        const validation = validatePositive(loanAmountInput.value, 'Loan Amount', 10000000);
        if (validation.valid) {
          rawAmount = validation.value;
          calculateEMI(false);
        }
      });

      interestInput.addEventListener('input', () => {
        const validation = validatePositive(interestInput.value, 'Interest Rate', 30);
        if (validation.valid && validation.value <= 30) {
          rawRate = validation.value;
          calculateEMI(false);
        }
      });

      tenureInput.addEventListener('input', () => {
        const validation = validatePositive(tenureInput.value, 'Tenure', 30);
        if (validation.valid && validation.value <= 30) {
          rawTenure = validation.value;
          calculateEMI(false);
        }
      });

      // ============================================
      // CALCULATE BUTTON
      // ============================================
      document.getElementById('emiCalculateBtn').addEventListener('click', () => {
        const amountResult = validatePositive(loanAmountInput.value, 'Loan Amount', 10000000);
        const rateResult = validatePositive(interestInput.value, 'Interest Rate', 30);
        const tenureResult = validatePositive(tenureInput.value, 'Tenure', 30);

        if (!amountResult.valid) {
          showValidationError(amountResult.message);
          loanAmountInput.focus();
          return;
        }
        if (!rateResult.valid) {
          showValidationError(rateResult.message);
          interestInput.focus();
          return;
        }
        if (!tenureResult.valid) {
          showValidationError(tenureResult.message);
          tenureInput.focus();
          return;
        }

        if (rateResult.value > 30) {
          showValidationError('Interest rate should be between 0% and 30%.');
          interestInput.focus();
          return;
        }
        if (tenureResult.value > 30) {
          showValidationError('Tenure should be between 1 and 30 years.');
          tenureInput.focus();
          return;
        }

        rawAmount = amountResult.value;
        rawRate = rateResult.value;
        rawTenure = tenureResult.value;

        calculateEMI();

        if (window.showToast) {
          window.showToast('✅ EMI calculated!', 'success');
        }
      });

      // ============================================
      // KEYBOARD SHORTCUTS
      // ============================================
      loanAmountInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') document.getElementById('emiCalculateBtn').click();
      });
      interestInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') document.getElementById('emiCalculateBtn').click();
      });
      tenureInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') document.getElementById('emiCalculateBtn').click();
      });

      // ============================================
      // INITIALIZE
      // ============================================
      calculateEMI();
    });
  </script>
</Layout>