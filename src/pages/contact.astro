---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Contact - FindInCalc">
  <Navbar />

  <main class="pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-6">Contact Us</h1>
      
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 border border-gray-200 dark:border-gray-700">
        <p class="text-gray-600 dark:text-gray-400 mb-6">
          Have questions, suggestions, or feedback? We'd love to hear from you!
        </p>
        
        <div class="space-y-4">
          <div class="flex items-center gap-3 text-gray-600 dark:text-gray-400">
            <span class="text-2xl">📧</span>
            <span>contact@findincalc.com</span>
          </div>
          <div class="flex items-center gap-3 text-gray-600 dark:text-gray-400">
            <span class="text-2xl">🐦</span>
            <span>@findincalc</span>
          </div>
          <div class="flex items-center gap-3 text-gray-600 dark:text-gray-400">
            <span class="text-2xl">📘</span>
            <span>facebook.com/findincalc</span>
          </div>
        </div>
        
        <div class="mt-6 p-4 bg-emerald-50 dark:bg-emerald-900/20 rounded-xl border border-emerald-200 dark:border-emerald-800">
          <p class="text-sm text-gray-600 dark:text-gray-300">
            💡 <span class="font-medium">Response time:</span> We typically respond within 24-48 hours.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>