---
// src/pages/health/bmr.astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import SEOContent from '../../components/SEOContent.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
---

<Layout title="BMR Calculator - Basal Metabolic Rate Calculator">
  <Navbar />

  <main class="pt-8 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-8 fade-in fade-in-delay-1">
        <span class="text-5xl">🔥</span>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mt-2">
          BMR Calculator
        </h1>
        <p class="text-gray-600 dark:text-gray-400">
          Calculate your Basal Metabolic Rate and daily calorie needs
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
        <!-- Left: Calculator -->
        <div class="lg:col-span-3">
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-4 sm:p-6 border border-gray-200 dark:border-gray-700">
            
            <!-- Mode Toggle -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
              <label class="text-sm font-medium text-gray-700 dark:text-gray-300 min-w-[100px]">
                Mode
              </label>
              <div class="flex flex-wrap gap-2">
                <button 
                  id="modeBMR"
                  class="bmr-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25"
                >
                  🔥 Find BMR
                </button>
                <button 
                  id="modeWeight"
                  class="bmr-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600"
                >
                  ⚖️ Find Weight
                </button>
                <button 
                  id="modeHeight"
                  class="bmr-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600"
                >
                  📏 Find Height
                </button>
              </div>
            </div>

            <!-- Unit Selector -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
              <label class="text-sm font-medium text-gray-700 dark:text-gray-300 min-w-[100px]">
                Unit System
              </label>
              <div class="flex flex-wrap gap-2">
                <button 
                  id="unitMetric"
                  class="bmr-unit-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25"
                >
                  Metric (kg/cm)
                </button>
                <button 
                  id="unitImperial"
                  class="bmr-unit-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600"
                >
                  Imperial (lbs/in)
                </button>
              </div>
            </div>

            <!-- Inputs -->
            <div class="space-y-4">
              <!-- Weight -->
              <div>
                <div class="flex justify-between items-center mb-2">
                  <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                    Weight = <span id="weightDisplay" class="text-emerald-600 font-bold">70</span> <span id="weightUnit">kg</span>
                  </label>
                </div>
                <input 
                  type="range" 
                  id="weightSlider"
                  class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                  min="20"
                  max="300"
                  step="any"
                  value="70"
                />
                <div class="flex justify-between text-xs text-gray-400 mt-1">
                  <span>20</span>
                  <span id="weightMaxLabel">300 kg</span>
                </div>
              </div>

              <!-- Height -->
              <div>
                <div class="flex justify-between items-center mb-2">
                  <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                    Height = <span id="heightDisplay" class="text-emerald-600 font-bold">175</span> <span id="heightUnit">cm</span>
                    <span id="heightFeetInches" class="text-gray-400 font-normal text-xs ml-1"></span>
                  </label>
                </div>
                <input 
                  type="range" 
                  id="heightSlider"
                  class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                  min="100"
                  max="250"
                  step="any"
                  value="175"
                />
                <div class="flex justify-between text-xs text-gray-400 mt-1">
                  <span>100</span>
                  <span id="heightMaxLabel">250 cm</span>
                </div>
              </div>

              <!-- Age -->
              <div>
                <div class="flex justify-between items-center mb-2">
                  <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                    Age = <span id="ageDisplay" class="text-emerald-600 font-bold">30</span> years
                  </label>
                </div>
                <input 
                  type="range" 
                  id="ageSlider"
                  class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                  min="10"
                  max="100"
                  step="1"
                  value="30"
                />
                <div class="flex justify-between text-xs text-gray-400 mt-1">
                  <span>10</span>
                  <span>100</span>
                </div>
              </div>

              <!-- Gender -->
              <div>
                <label class="text-sm font-medium text-gray-700 dark:text-gray-300 block mb-2">
                  Gender
                </label>
                <div class="flex gap-3">
                  <button 
                    id="genderMale"
                    class="gender-btn flex-1 px-4 py-2.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25"
                  >
                    👨 Male
                  </button>
                  <button 
                    id="genderFemale"
                    class="gender-btn flex-1 px-4 py-2.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600"
                  >
                    👩 Female
                  </button>
                </div>
              </div>

              <!-- Input Fields -->
              <div id="bmrInputRow" class="flex flex-col sm:flex-row gap-3">
                <div class="flex-1">
                  <input 
                    type="number" 
                    id="weightInput"
                    class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                    placeholder="Weight"
                    value="70"
                    step="any"
                    min="20"
                  />
                </div>
                <div class="flex-1">
                  <input 
                    type="number" 
                    id="heightInput"
                    class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                    placeholder="Height"
                    value="175"
                    step="any"
                    min="100"
                  />
                </div>
                <div class="flex-1">
                  <input 
                    type="number" 
                    id="ageInput"
                    class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                    placeholder="Age"
                    value="30"
                    step="1"
                    min="10"
                    max="100"
                  />
                </div>
                <button 
                  id="bmrCalculateBtn"
                  class="btn-primary px-8 py-2.5 whitespace-nowrap"
                >
                  Calculate
                </button>
              </div>
            </div>

            <!-- BMR Result Box -->
            <div id="bmrResultBox" class="mt-6 rounded-xl p-4 border border-emerald-500 bg-emerald-50 dark:bg-emerald-900/20 hidden">
              <!-- Row 1: BMR Value -->
              <div class="text-center">
                <p class="text-sm text-gray-600 dark:text-gray-400">Your BMR</p>
                <p class="text-5xl font-bold text-emerald-600 dark:text-emerald-400" id="bmrResultValue">1,500</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">calories/day</p>
              </div>

              <!-- Row 2: Daily Calorie Needs -->
              <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="p-3 rounded-lg bg-white/50 dark:bg-gray-700/50 text-center">
                  <p class="text-xs text-gray-500 dark:text-gray-400">Sedentary</p>
                  <p class="text-sm font-bold text-gray-700 dark:text-gray-300" id="sedentaryCal">1,800</p>
                </div>
                <div class="p-3 rounded-lg bg-white/50 dark:bg-gray-700/50 text-center">
                  <p class="text-xs text-gray-500 dark:text-gray-400">Light Exercise</p>
                  <p class="text-sm font-bold text-gray-700 dark:text-gray-300" id="lightCal">2,100</p>
                </div>
                <div class="p-3 rounded-lg bg-white/50 dark:bg-gray-700/50 text-center">
                  <p class="text-xs text-gray-500 dark:text-gray-400">Moderate Exercise</p>
                  <p class="text-sm font-bold text-gray-700 dark:text-gray-300" id="moderateCal">2,300</p>
                </div>
                <div class="p-3 rounded-lg bg-white/50 dark:bg-gray-700/50 text-center">
                  <p class="text-xs text-gray-500 dark:text-gray-400">Heavy Exercise</p>
                  <p class="text-sm font-bold text-gray-700 dark:text-gray-300" id="heavyCal">2,600</p>
                </div>
              </div>
            </div>

            <!-- Disclaimer -->
            <div class="mt-4 p-4 rounded-xl bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700">
              <p class="text-xs text-gray-500 dark:text-gray-400">
                ⚠️ <span class="font-medium">Disclaimer:</span> BMR is an estimate and may not be accurate for all individuals. Consult a healthcare professional for personalized advice.
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Information -->
        <div class="lg:col-span-2 space-y-4">
          <!-- BMR Categories -->
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-3">📊 BMR Categories</h3>
            <div class="space-y-2 text-sm">
              <div class="flex items-center justify-between p-2 rounded-lg bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800">
                <span class="text-gray-700 dark:text-gray-300"><strong>Very Low</strong> &lt; 1,200</span>
                <span class="text-blue-600 dark:text-blue-400">⚠️</span>
              </div>
              <div class="flex items-center justify-between p-2 rounded-lg bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800">
                <span class="text-gray-700 dark:text-gray-300"><strong>Normal</strong> 1,200 – 2,000</span>
                <span class="text-green-600 dark:text-green-400">✅</span>
              </div>
              <div class="flex items-center justify-between p-2 rounded-lg bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800">
                <span class="text-gray-700 dark:text-gray-300"><strong>High</strong> 2,000 – 3,000</span>
                <span class="text-yellow-600 dark:text-yellow-400">💪</span>
              </div>
              <div class="flex items-center justify-between p-2 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800">
                <span class="text-gray-700 dark:text-gray-300"><strong>Very High</strong> &gt; 3,000</span>
                <span class="text-red-600 dark:text-red-400">🔥</span>
              </div>
            </div>
          </div>

          <!-- Formula Card -->
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-3">📐 Formula</h3>
            <div class="bg-gray-100 dark:bg-gray-700 rounded-xl p-4 text-center">
              <p class="text-xl font-mono text-gray-800 dark:text-gray-200" id="bmrFormula">BMR = 10 × weight + 6.25 × height - 5 × age + 5</p>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1" id="bmrFormulaDetail">Mifflin-St Jeor Equation (Male)</p>
            </div>
            <div class="mt-4 space-y-2 text-sm text-gray-600 dark:text-gray-400">
              <div class="flex justify-between border-b border-gray-100 dark:border-gray-700 pb-2">
                <span>Weight</span>
                <span class="font-mono" id="bmrWeight">70 kg</span>
              </div>
              <div class="flex justify-between border-b border-gray-100 dark:border-gray-700 pb-2">
                <span>Height</span>
                <span class="font-mono" id="bmrHeight">175 cm</span>
              </div>
              <div class="flex justify-between border-b border-gray-100 dark:border-gray-700 pb-2">
                <span>Age</span>
                <span class="font-mono" id="bmrAge">30 years</span>
              </div>
              <div class="flex justify-between border-b border-gray-100 dark:border-gray-700 pb-2">
                <span>Gender</span>
                <span class="font-mono" id="bmrGender">Male</span>
              </div>
              <div class="flex justify-between font-bold text-emerald-600 dark:text-emerald-400 pt-1">
                <span>BMR</span>
                <span class="font-mono" id="bmrResultFormula">1,500 cal/day</span>
              </div>
            </div>
          </div>

          <!-- Step-by-Step -->
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-3">📝 Step-by-Step</h3>
            <div class="space-y-2 text-sm">
              <div class="flex items-start gap-3 p-2 rounded-lg bg-gray-50 dark:bg-gray-700/50">
                <span class="text-emerald-500 font-bold min-w-[24px]">1.</span>
                <span class="text-gray-600 dark:text-gray-400" id="step1">Formula: BMR = 10 × weight + 6.25 × height - 5 × age + 5</span>
              </div>
              <div class="flex items-start gap-3 p-2 rounded-lg bg-gray-50 dark:bg-gray-700/50">
                <span class="text-emerald-500 font-bold min-w-[24px]">2.</span>
                <span class="text-gray-600 dark:text-gray-400" id="step2">Plug in: 10 × 70 + 6.25 × 175 - 5 × 30 + 5</span>
              </div>
              <div class="flex items-start gap-3 p-2 rounded-lg bg-gray-50 dark:bg-gray-700/50">
                <span class="text-emerald-500 font-bold min-w-[24px]">3.</span>
                <span class="text-gray-600 dark:text-gray-400" id="step3">Calculate: 700 + 1093.75 - 150 + 5 = 1,648.75</span>
              </div>
              <div class="flex items-start gap-3 p-3 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800">
                <span class="text-emerald-600 dark:text-emerald-400 font-bold min-w-[24px]">✓</span>
                <span class="font-bold text-emerald-600 dark:text-emerald-400" id="step4">Result: BMR = 1,648.75 cal/day</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SEO Content -->
      <SEOContent 
        title="What is a BMR Calculator?"
        description="A BMR (Basal Metabolic Rate) calculator helps you estimate how many calories your body burns at rest. Learn about your metabolic rate and daily calorie needs."
        formula="BMR = 10 × weight + 6.25 × height - 5 × age + 5"
        formulaDescription="Mifflin-St Jeor Equation for Men (Women use -161 instead of +5)"
        example={{
          title: "Example: Calculate BMR for a 30-year-old male, 70 kg, 175 cm",
          steps: [
            "BMR = 10 × 70 + 6.25 × 175 - 5 × 30 + 5",
            "BMR = 700 + 1093.75 - 150 + 5",
            "BMR = 1,648.75 cal/day"
          ],
          result: "BMR = 1,649 cal/day"
        }}
        uses={[
          "Weight Management: Understand your baseline calorie needs",
          "Fitness Planning: Calculate daily calorie requirements for goals",
          "Nutrition: Plan balanced meals based on energy needs",
          "Health Monitoring: Track metabolic changes over time"
        ]}
        faqs={[
          {
            question: "What is BMR?",
            answer: "BMR (Basal Metabolic Rate) is the number of calories your body burns at complete rest. It represents the minimum energy needed to keep your body functioning."
          },
          {
            question: "What's the difference between BMR and BMI?",
            answer: "BMI measures body fat based on height and weight. BMR measures how many calories your body burns at rest. They're complementary health metrics."
          },
          {
            question: "Why does gender matter for BMR?",
            answer: "Men typically have more muscle mass and less body fat, which increases their metabolic rate. The formula accounts for these differences."
          }
        ]}
        note="BMR is an estimate and may vary based on muscle mass, genetics, and other factors. Use it as a guideline for planning your nutrition and fitness goals."
      />

      <!-- Related Calculators -->
      <RelatedCalculators currentId="bmr" />
    </div>
  </main>

  <script>
    import { validatePositiveNumber } from '../../lib/calculator/validation';
    import { formatNumber, formatResult, formatDecimal } from '../../lib/calculator/formatting';
    
    document.addEventListener('DOMContentLoaded', () => {
      // ============================================
      // STATE
      // ============================================
      let currentUnit = 'metric';
      let currentMode = 'bmr'; // 'bmr', 'weight', 'height'
      let currentGender = 'male';
      let rawWeight = 70;
      let rawHeight = 175;
      let rawAge = 30;

      // ============================================
      // VALIDATION HELPERS
      // ============================================
      function validatePositive(value, name, maxVal) {
        const result = validatePositiveNumber(value, name, maxVal);
        if (!result.valid) {
          return { valid: false, message: result.message };
        }
        return { valid: true, value: result.value };
      }

      // ============================================
      // DOM REFERENCES
      // ============================================
      const weightSlider = document.getElementById('weightSlider');
      const heightSlider = document.getElementById('heightSlider');
      const ageSlider = document.getElementById('ageSlider');
      const weightInput = document.getElementById('weightInput');
      const heightInput = document.getElementById('heightInput');
      const ageInput = document.getElementById('ageInput');
      const weightDisplay = document.getElementById('weightDisplay');
      const heightDisplay = document.getElementById('heightDisplay');
      const ageDisplay = document.getElementById('ageDisplay');
      const weightUnit = document.getElementById('weightUnit');
      const heightUnit = document.getElementById('heightUnit');
      const weightMaxLabel = document.getElementById('weightMaxLabel');
      const heightMaxLabel = document.getElementById('heightMaxLabel');
      const heightFeetInches = document.getElementById('heightFeetInches');
      
      const bmrResultValue = document.getElementById('bmrResultValue');
      const bmrResultBox = document.getElementById('bmrResultBox');
      const bmrFormula = document.getElementById('bmrFormula');
      const bmrFormulaDetail = document.getElementById('bmrFormulaDetail');
      const bmrWeight = document.getElementById('bmrWeight');
      const bmrHeight = document.getElementById('bmrHeight');
      const bmrAge = document.getElementById('bmrAge');
      const bmrGender = document.getElementById('bmrGender');
      const bmrResultFormula = document.getElementById('bmrResultFormula');
      
      const sedentaryCal = document.getElementById('sedentaryCal');
      const lightCal = document.getElementById('lightCal');
      const moderateCal = document.getElementById('moderateCal');
      const heavyCal = document.getElementById('heavyCal');
      
      const step1 = document.getElementById('step1');
      const step2 = document.getElementById('step2');
      const step3 = document.getElementById('step3');
      const step4 = document.getElementById('step4');

      function showValidationError(message) {
        if (window.showToast) window.showToast(message, 'error');
        else window.alert(message);
      }

      // ============================================
      // UNIT CONVERSIONS
      // ============================================
      const unitConversions = {
        metric: {
          weightLabel: 'kg',
          heightLabel: 'cm',
          weightMax: '300 kg',
          heightMax: '250 cm',
          weightMin: 20,
          weightMaxNum: 300,
          heightMin: 100,
          heightMaxNum: 250,
          weightInputMax: 300,
          heightInputMax: 250,
          weightInputMin: 20,
          heightInputMin: 100,
          ageMin: 10,
          ageMax: 100,
          convertWeight: (w) => w,
          convertHeight: (h) => h,
          weightFactor: 1,
          heightFactor: 1
        },
        imperial: {
          weightLabel: 'lbs',
          heightLabel: 'in',
          weightMax: '660 lbs',
          heightMax: '98 in',
          weightMin: 44,
          weightMaxNum: 660,
          heightMin: 39,
          heightMaxNum: 98,
          weightInputMax: 660,
          heightInputMax: 98,
          weightInputMin: 44,
          heightInputMin: 39,
          ageMin: 10,
          ageMax: 100,
          convertWeight: (w) => w / 0.453592,
          convertHeight: (h) => h / 2.54,
          weightFactor: 0.453592,
          heightFactor: 2.54
        }
      };

      // ============================================
      // UPDATE BMR
      // ============================================
      function updateBMR(syncInputs = true) {
        const unit = unitConversions[currentUnit];
        let weight, height, age, gender;

        if (currentMode === 'bmr') {
          weight = rawWeight;
          height = rawHeight;
          age = rawAge;
          gender = currentGender;
        } else if (currentMode === 'weight') {
          weight = rawWeight;
          height = rawHeight;
          age = rawAge;
          gender = currentGender;
        } else {
          weight = rawWeight;
          height = rawHeight;
          age = rawAge;
          gender = currentGender;
        }

        // Get values in metric for calculation
        const weightKg = unit === unitConversions.metric ? weight : weight * 0.453592;
        const heightCm = unit === unitConversions.metric ? height : height * 2.54;

        // Calculate BMR
        let bmr;
        if (gender === 'male') {
          bmr = 10 * weightKg + 6.25 * heightCm - 5 * age + 5;
        } else {
          bmr = 10 * weightKg + 6.25 * heightCm - 5 * age - 161;
        }

        const formattedBMR = formatNumber(bmr, { maximumFractionDigits: 0, useGrouping: true });

        // Update displays
        weightDisplay.textContent = formatNumber(weight, { maximumFractionDigits: 1 });
        heightDisplay.textContent = formatNumber(height, { maximumFractionDigits: 1 });
        ageDisplay.textContent = formatNumber(age, { maximumFractionDigits: 0 });

        // Show result
        bmrResultBox.classList.remove('hidden');
        bmrResultValue.textContent = formattedBMR;

        // Calculate daily calorie needs (activity multipliers)
        const sedentary = bmr * 1.2;
        const light = bmr * 1.375;
        const moderate = bmr * 1.55;
        const heavy = bmr * 1.725;

        sedentaryCal.textContent = formatNumber(sedentary, { maximumFractionDigits: 0, useGrouping: true });
        lightCal.textContent = formatNumber(light, { maximumFractionDigits: 0, useGrouping: true });
        moderateCal.textContent = formatNumber(moderate, { maximumFractionDigits: 0, useGrouping: true });
        heavyCal.textContent = formatNumber(heavy, { maximumFractionDigits: 0, useGrouping: true });

        // Update formula card
        const genderLabel = gender === 'male' ? 'Male' : 'Female';
        const formulaText = gender === 'male' 
          ? 'BMR = 10 × weight + 6.25 × height - 5 × age + 5'
          : 'BMR = 10 × weight + 6.25 × height - 5 × age - 161';
        bmrFormula.textContent = formulaText;
        bmrFormulaDetail.textContent = `Mifflin-St Jeor Equation (${genderLabel})`;
        bmrWeight.textContent = `${formatNumber(weight, { maximumFractionDigits: 1 })} ${unit.weightLabel}`;
        bmrHeight.textContent = `${formatNumber(height, { maximumFractionDigits: 1 })} ${unit.heightLabel}`;
        bmrAge.textContent = `${formatNumber(age, { maximumFractionDigits: 0 })} years`;
        bmrGender.textContent = genderLabel;
        bmrResultFormula.textContent = `${formattedBMR} cal/day`;

        // Update steps
        const genderSign = gender === 'male' ? '+5' : '-161';
        step1.textContent = `Formula: ${formulaText}`;
        step2.textContent = `Plug in: 10 × ${formatNumber(weight, { maximumFractionDigits: 1 })} + 6.25 × ${formatNumber(height, { maximumFractionDigits: 1 })} - 5 × ${formatNumber(age, { maximumFractionDigits: 0 })} ${genderSign}`;
        step3.textContent = `Calculate: ${formatNumber(10 * weightKg, { maximumFractionDigits: 1 })} + ${formatNumber(6.25 * heightCm, { maximumFractionDigits: 2 })} - ${formatNumber(5 * age, { maximumFractionDigits: 0 })} = ${formattedBMR}`;
        step4.textContent = `Result: BMR = ${formattedBMR} cal/day`;

        // Update sliders
        if (syncInputs) {
          weightSlider.value = weight;
          heightSlider.value = height;
          ageSlider.value = age;
          weightInput.value = weight;
          heightInput.value = height;
          ageInput.value = age;
        }
      }

      // ============================================
      // UNIT TOGGLE
      // ============================================
      document.getElementById('unitMetric').addEventListener('click', () => {
        document.querySelectorAll('.bmr-unit-btn').forEach(b => {
          b.className = 'bmr-unit-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600';
        });
        document.getElementById('unitMetric').className = 'bmr-unit-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25';
        
        const oldUnit = currentUnit;
        const newUnit = 'metric';
        if (oldUnit !== newUnit) {
          const old = unitConversions[oldUnit];
          const nu = unitConversions[newUnit];
          rawWeight = rawWeight * old.weightFactor / nu.weightFactor;
          rawHeight = rawHeight * old.heightFactor / nu.heightFactor;
        }
        currentUnit = newUnit;
        updateBMR();
      });

      document.getElementById('unitImperial').addEventListener('click', () => {
        document.querySelectorAll('.bmr-unit-btn').forEach(b => {
          b.className = 'bmr-unit-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600';
        });
        document.getElementById('unitImperial').className = 'bmr-unit-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25';
        
        const oldUnit = currentUnit;
        const newUnit = 'imperial';
        if (oldUnit !== newUnit) {
          const old = unitConversions[oldUnit];
          const nu = unitConversions[newUnit];
          rawWeight = rawWeight * old.weightFactor / nu.weightFactor;
          rawHeight = rawHeight * old.heightFactor / nu.heightFactor;
        }
        currentUnit = newUnit;
        updateBMR();
      });

      // ============================================
      // GENDER TOGGLE
      // ============================================
      document.getElementById('genderMale').addEventListener('click', () => {
        document.querySelectorAll('.gender-btn').forEach(b => {
          b.className = 'gender-btn flex-1 px-4 py-2.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600';
        });
        document.getElementById('genderMale').className = 'gender-btn flex-1 px-4 py-2.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25';
        currentGender = 'male';
        updateBMR();
      });

      document.getElementById('genderFemale').addEventListener('click', () => {
        document.querySelectorAll('.gender-btn').forEach(b => {
          b.className = 'gender-btn flex-1 px-4 py-2.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600';
        });
        document.getElementById('genderFemale').className = 'gender-btn flex-1 px-4 py-2.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25';
        currentGender = 'female';
        updateBMR();
      });

      // ============================================
      // SLIDER EVENTS
      // ============================================
      weightSlider.addEventListener('input', () => {
        rawWeight = parseFloat(weightSlider.value);
        updateBMR();
      });
      heightSlider.addEventListener('input', () => {
        rawHeight = parseFloat(heightSlider.value);
        updateBMR();
      });
      ageSlider.addEventListener('input', () => {
        rawAge = parseFloat(ageSlider.value);
        updateBMR();
      });

      // ============================================
      // INPUT EVENTS
      // ============================================
      weightInput.addEventListener('input', () => {
        const validation = validatePositive(weightInput.value, 'Weight', unitConversions[currentUnit].weightInputMax);
        if (validation.valid) {
          rawWeight = validation.value;
          updateBMR(false);
        }
      });

      heightInput.addEventListener('input', () => {
        const validation = validatePositive(heightInput.value, 'Height', unitConversions[currentUnit].heightInputMax);
        if (validation.valid) {
          rawHeight = validation.value;
          updateBMR(false);
        }
      });

      ageInput.addEventListener('input', () => {
        const validation = validatePositive(ageInput.value, 'Age', 120);
        if (validation.valid && validation.value >= 10 && validation.value <= 120) {
          rawAge = validation.value;
          updateBMR(false);
        }
      });

      // ============================================
      // CALCULATE BUTTON
      // ============================================
      document.getElementById('bmrCalculateBtn').addEventListener('click', () => {
        const weightResult = validatePositive(weightInput.value, 'Weight', unitConversions[currentUnit].weightInputMax);
        const heightResult = validatePositive(heightInput.value, 'Height', unitConversions[currentUnit].heightInputMax);
        const ageResult = validatePositive(ageInput.value, 'Age', 120);

        if (!weightResult.valid) {
          showValidationError(weightResult.message);
          weightInput.focus();
          return;
        }
        if (!heightResult.valid) {
          showValidationError(heightResult.message);
          heightInput.focus();
          return;
        }
        if (!ageResult.valid || ageResult.value < 10 || ageResult.value > 120) {
          showValidationError('Age must be between 10 and 120.');
          ageInput.focus();
          return;
        }

        rawWeight = weightResult.value;
        rawHeight = heightResult.value;
        rawAge = ageResult.value;

        weightSlider.value = rawWeight;
        heightSlider.value = rawHeight;
        ageSlider.value = rawAge;

        updateBMR();

        if (window.showToast) {
          window.showToast('✅ BMR calculated!', 'success');
        }
      });

      // ============================================
      // KEYBOARD SHORTCUTS: ENTER KEY
      // ============================================
      weightInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') document.getElementById('bmrCalculateBtn').click();
      });
      heightInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') document.getElementById('bmrCalculateBtn').click();
      });
      ageInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') document.getElementById('bmrCalculateBtn').click();
      });

      // ============================================
      // INITIALIZE
      // ============================================
      updateBMR();
    });
  </script>
</Layout>