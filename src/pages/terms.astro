---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Terms of Service - FindInCalc">
  <Navbar />

  <main class="pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-6">Terms of Service</h1>
      
      <div class="prose prose-emerald dark:prose-invert max-w-none">
        <p class="text-gray-600 dark:text-gray-300">Last updated: August 2026</p>
        
        <h2>Acceptance of Terms</h2>
        <p>By using FindInCalc, you agree to these terms of service.</p>
        
        <h2>Use of Services</h2>
        <p>FindInCalc provides free calculators and tools for educational and personal use. All tools are provided "as is" without warranties of any kind.</p>
        
        <h2>Disclaimer</h2>
        <p>While we strive for accuracy, FindInCalc makes no guarantees about the accuracy of calculations. Always verify critical calculations independently.</p>
        
        <h2>Intellectual Property</h2>
        <p>All content, design, and code on FindInCalc is owned by FindInCalc and may not be reproduced without permission.</p>
        
        <h2>Contact</h2>
        <p>For questions about these terms, contact us at legal@findincalc.com</p>
      </div>
    </div>
  </main>
</Layout>