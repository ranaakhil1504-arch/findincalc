---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Privacy Policy - FindInCalc">
  <Navbar />

  <main class="pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-6">Privacy Policy</h1>
      
      <div class="prose prose-emerald dark:prose-invert max-w-none">
        <p class="text-gray-600 dark:text-gray-300">Last updated: August 2026</p>
        
        <h2>Information We Collect</h2>
        <p>FindInCalc does not collect, store, or share any personal information. All calculations are performed in your browser and never sent to our servers.</p>
        
        <h2>Cookies</h2>
        <p>We use cookies for:</p>
        <ul>
          <li><strong>Preferences:</strong> Remember your theme preference (dark/light mode) and unit settings</li>
          <li><strong>Analytics:</strong> Anonymous usage data to improve our tools</li>
        </ul>
        
        <h2>Third-Party Services</h2>
        <ul>
          <li><strong>Google Analytics:</strong> Used for anonymous traffic analysis</li>
          <li><strong>Cloudflare:</strong> Hosting provider for this website</li>
        </ul>
        
        <h2>Contact</h2>
        <p>For privacy-related questions, contact us at privacy@findincalc.com</p>
      </div>
    </div>
  </main>
</Layout>