---
// src/pages/privacy.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Privacy Policy - FindInCalc">
  <Navbar />

  <main class="pt-8 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-8 fade-in">
        <span class="text-5xl">🔒</span>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mt-2">
          Privacy Policy
        </h1>
        <p class="text-gray-600 dark:text-gray-400">
          Your privacy matters to us
        </p>
        <div class="w-20 h-1 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full mx-auto mt-4"></div>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 border border-gray-200 dark:border-gray-700">
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Last updated: August 2026</p>

        <div class="space-y-6">
          <div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Information We Collect</h2>
            <p class="text-gray-600 dark:text-gray-400">
              FindInCalc does not collect, store, or share any personal information. All calculations are performed in your browser and never sent to our servers.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Cookies</h2>
            <p class="text-gray-600 dark:text-gray-400">We use cookies for:</p>
            <ul class="list-disc pl-6 space-y-1 text-gray-600 dark:text-gray-400">
              <li><strong>Preferences:</strong> Remember your theme preference (dark/light mode) and unit settings</li>
              <li><strong>Analytics:</strong> Anonymous usage data to improve our tools</li>
            </ul>
          </div>

          <div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Third-Party Services</h2>
            <ul class="list-disc pl-6 space-y-1 text-gray-600 dark:text-gray-400">
              <li><strong>Google Analytics:</strong> Used for anonymous traffic analysis</li>
              <li><strong>Cloudflare:</strong> Hosting provider for this website</li>
            </ul>
          </div>

          <div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Your Rights</h2>
            <p class="text-gray-600 dark:text-gray-400">
              Since we don't collect personal data, there's no data to access, modify, or delete. If you have any concerns, please contact us.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Contact</h2>
            <p class="text-gray-600 dark:text-gray-400">
              For privacy-related questions, contact us at:
              <a href="mailto:privacy@findincalc.com" class="text-emerald-600 dark:text-emerald-400 hover:underline">
                privacy@findincalc.com
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>