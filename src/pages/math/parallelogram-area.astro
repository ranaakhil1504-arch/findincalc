---
// src/pages/math/parallelogram-area.astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import SEOContent from '../../components/SEOContent.astro';
---

<Layout title="Parallelogram Calculator - Interactive Math Tool">
  <Navbar />

  <main class="pt-8 pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-8 fade-in fade-in-delay-1">
        <span class="text-5xl">▱</span>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mt-2">
          Parallelogram Calculator
        </h1>
        <p class="text-gray-600 dark:text-gray-400">
          Calculate area, find base, or find height
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
        <!-- Left: Interactive Visualization -->
        <div class="lg:col-span-3">
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-4 sm:p-6 border border-gray-200 dark:border-gray-700">
            
            <!-- Mode Toggle -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
              <label class="text-sm font-medium text-gray-700 dark:text-gray-300 min-w-[100px]">
                Mode
              </label>
              <div class="flex flex-wrap gap-2">
                <button 
                  id="modeAreaPara"
                  class="para-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25"
                >
                  📐 Find Area
                </button>
                <button 
                  id="modeBasePara"
                  class="para-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600"
                >
                  📏 Find Base
                </button>
                <button 
                  id="modeHeightPara"
                  class="para-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600"
                >
                  📐 Find Height
                </button>
              </div>
            </div>

            <!-- SVG Parallelogram Visualization -->
            <div class="relative w-full max-w-lg mx-auto aspect-square">
              <svg viewBox="0 0 500 500" class="w-full h-full">
                <defs>
                  <pattern id="gridPara" width="25" height="25" patternUnits="userSpaceOnUse">
                    <path d="M 25 0 L 0 0 0 25" fill="none" stroke="#e5e7eb" stroke-width="0.5" class="dark:stroke-gray-700"/>
                  </pattern>
                  <linearGradient id="paraGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#0d9488" stop-opacity="0.8"/>
                    <stop offset="100%" stop-color="#0d9488" stop-opacity="0.05"/>
                  </linearGradient>
                </defs>
                
                <rect width="500" height="500" fill="url(#gridPara)"/>
                
                <polygon 
                  id="paraVisual"
                  points="150,150 350,150 400,350 200,350"
                  fill="url(#paraGradient)"
                  stroke="#0d9488"
                  stroke-width="3"
                  class="transition-all duration-500 ease-out"
                />
                
                <text 
                  id="baseLabelPara"
                  x="250" 
                  y="375" 
                  fill="#f59e0b" 
                  font-size="16" 
                  font-weight="bold"
                  text-anchor="middle"
                  class="transition-all duration-500 ease-out"
                >
                  Base = <tspan id="baseLabelParaValue">10</tspan> cm
                </text>
                
                <text 
                  id="heightLabelPara"
                  x="80" 
                  y="250" 
                  fill="#ef4444" 
                  font-size="16" 
                  font-weight="bold"
                  class="transition-all duration-500 ease-out"
                >
                  Height = <tspan id="heightLabelParaValue">6</tspan> cm
                </text>

                <line 
                  id="heightLinePara"
                  x1="200" 
                  y1="150" 
                  x2="200" 
                  y2="350"
                  stroke="#ef4444"
                  stroke-width="2"
                  stroke-dasharray="6,4"
                />
                
                <text 
                  id="sideLabelPara"
                  x="360" 
                  y="255" 
                  fill="#8b5cf6" 
                  font-size="14" 
                  font-weight="bold"
                  class="transition-all duration-500 ease-out"
                >
                  Side = <tspan id="sideLabelParaValue">8</tspan> cm
                </text>

                <text 
                  id="areaLabelPara"
                  x="250" 
                  y="430" 
                  fill="#0d9488" 
                  font-size="18" 
                  font-weight="bold"
                  text-anchor="middle"
                  class="transition-all duration-500 ease-out"
                >
                  A = <tspan id="areaLabelParaValue">60</tspan> cm²
                </text>
              </svg>
            </div>

            <!-- Controls -->
            <div class="mt-6 space-y-4">
              <!-- Unit Selector -->
              <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                <label class="text-sm font-medium text-gray-700 dark:text-gray-300 min-w-[100px]">
                  Unit System
                </label>
                <div class="flex flex-wrap gap-2">
                  {['cm', 'm', 'in', 'ft'].map((unit) => (
                    <button 
                      class={`para-unit-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all ${
                        unit === 'cm' 
                          ? 'bg-emerald-600 text-white shadow-lg shadow-emerald-500/25' 
                          : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600'
                      }`}
                      data-unit={unit}
                    >
                      {unit}
                    </button>
                  ))}
                </div>
              </div>

              <!-- Dynamic Input Section -->
              <div id="paraInputSection">
                <!-- Find Area Mode (Default) -->
                <div id="paraAreaModeInputs">
                  <div>
                    <div class="flex justify-between items-center mb-2">
                      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                        Base (b) = <span id="baseDisplayPara" class="text-emerald-600 font-bold">10</span> <span id="baseUnitDisplayPara">cm</span>
                      </label>
                    </div>
                    <input 
                      type="range" 
                      id="baseSliderPara"
                      class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                      min="1"
                      max="20"
                      step="0.5"
                      value="10"
                    />
                    <div class="flex justify-between text-xs text-gray-400 mt-1">
                      <span>1</span>
                      <span>20</span>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between items-center mb-2">
                      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                        Height (h) = <span id="heightDisplayPara" class="text-emerald-600 font-bold">6</span> <span id="heightUnitDisplayPara">cm</span>
                      </label>
                    </div>
                    <input 
                      type="range" 
                      id="heightSliderPara"
                      class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                      min="1"
                      max="20"
                      step="0.5"
                      value="6"
                    />
                    <div class="flex justify-between text-xs text-gray-400 mt-1">
                      <span>1</span>
                      <span>20</span>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between items-center mb-2">
                      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                        Side (s) = <span id="sideDisplayPara" class="text-emerald-600 font-bold">8</span> <span id="sideUnitDisplayPara">cm</span>
                      </label>
                    </div>
                    <input 
                      type="range" 
                      id="sideSliderPara"
                      class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                      min="1"
                      max="20"
                      step="0.5"
                      value="8"
                    />
                    <div class="flex justify-between text-xs text-gray-400 mt-1">
                      <span>1</span>
                      <span>20</span>
                    </div>
                  </div>

                  <div class="flex flex-col sm:flex-row gap-2">
                    <div class="flex-1">
                      <input 
                        type="number" 
                        id="baseInputPara"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                        placeholder="Base (b)"
                        value="10"
                        step="0.5"
                        min="1"
                      />
                    </div>
                    <div class="flex-1">
                      <input 
                        type="number" 
                        id="heightInputPara"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                        placeholder="Height (h)"
                        value="6"
                        step="0.5"
                        min="1"
                      />
                    </div>
                    <div class="flex-1">
                      <input 
                        type="number" 
                        id="sideInputPara"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                        placeholder="Side (s)"
                        value="8"
                        step="0.5"
                        min="1"
                      />
                    </div>
                    <button 
                      id="paraCalculateBtn"
                      class="btn-primary px-6 py-2.5 whitespace-nowrap"
                    >
                      Calculate
                    </button>
                  </div>
                </div>

                <!-- Find Base Mode -->
                <div id="paraBaseModeInputs" class="hidden">
                  <div>
                    <div class="flex justify-between items-center mb-2">
                      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                        Area = <span id="areaForBaseDisplay" class="text-emerald-600 font-bold">60</span> <span id="areaForBaseUnit">cm²</span>
                      </label>
                    </div>
                    <input 
                      type="range" 
                      id="areaForBaseSlider"
                      class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                      min="1"
                      max="400"
                      step="0.5"
                      value="60"
                    />
                    <div class="flex justify-between text-xs text-gray-400 mt-1">
                      <span>1</span>
                      <span id="areaBaseMaxLabel">400</span>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between items-center mb-2">
                      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                        Height (h) = <span id="heightForBaseDisplay" class="text-emerald-600 font-bold">6</span> <span id="heightForBaseUnit">cm</span>
                      </label>
                    </div>
                    <input 
                      type="range" 
                      id="heightForBaseSlider"
                      class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                      min="1"
                      max="20"
                      step="0.5"
                      value="6"
                    />
                    <div class="flex justify-between text-xs text-gray-400 mt-1">
                      <span>1</span>
                      <span>20</span>
                    </div>
                  </div>

                  <div class="flex flex-col sm:flex-row gap-2">
                    <div class="flex-1">
                      <input 
                        type="number" 
                        id="areaForBaseInput"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                        placeholder="Area"
                        value="60"
                        step="0.5"
                        min="1"
                      />
                    </div>
                    <div class="flex-1">
                      <input 
                        type="number" 
                        id="heightForBaseInput"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                        placeholder="Height (h)"
                        value="6"
                        step="0.5"
                        min="1"
                      />
                    </div>
                    <button 
                      id="findBaseParaBtn"
                      class="btn-primary px-6 py-2.5 whitespace-nowrap"
                    >
                      Find Base
                    </button>
                  </div>
                </div>

                <!-- Find Height Mode -->
                <div id="paraHeightModeInputs" class="hidden">
                  <div>
                    <div class="flex justify-between items-center mb-2">
                      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                        Area = <span id="areaForHeightDisplay" class="text-emerald-600 font-bold">60</span> <span id="areaForHeightUnit">cm²</span>
                      </label>
                    </div>
                    <input 
                      type="range" 
                      id="areaForHeightSlider"
                      class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                      min="1"
                      max="400"
                      step="0.5"
                      value="60"
                    />
                    <div class="flex justify-between text-xs text-gray-400 mt-1">
                      <span>1</span>
                      <span id="areaHeightMaxLabel">400</span>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between items-center mb-2">
                      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">
                        Base (b) = <span id="baseForHeightDisplay" class="text-emerald-600 font-bold">10</span> <span id="baseForHeightUnit">cm</span>
                      </label>
                    </div>
                    <input 
                      type="range" 
                      id="baseForHeightSlider"
                      class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                      min="1"
                      max="20"
                      step="0.5"
                      value="10"
                    />
                    <div class="flex justify-between text-xs text-gray-400 mt-1">
                      <span>1</span>
                      <span>20</span>
                    </div>
                  </div>

                  <div class="flex flex-col sm:flex-row gap-2">
                    <div class="flex-1">
                      <input 
                        type="number" 
                        id="areaForHeightInput"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                        placeholder="Area"
                        value="60"
                        step="0.5"
                        min="1"
                      />
                    </div>
                    <div class="flex-1">
                      <input 
                        type="number" 
                        id="baseForHeightInput"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                        placeholder="Base (b)"
                        value="10"
                        step="0.5"
                        min="1"
                      />
                    </div>
                    <button 
                      id="findHeightParaBtn"
                      class="btn-primary px-6 py-2.5 whitespace-nowrap"
                    >
                      Find Height
                    </button>
                  </div>
                </div>
              </div>

              <!-- Result Box -->
              <div id="paraResultBox" class="bg-gradient-to-r from-emerald-50 to-teal-50 dark:from-emerald-900/20 dark:to-teal-900/20 rounded-xl p-4 border border-emerald-200 dark:border-emerald-800">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-sm text-gray-600 dark:text-gray-400" id="paraResultLabel">Area of Parallelogram</p>
                    <p class="text-3xl font-bold text-emerald-600 dark:text-emerald-400" id="paraResultValue">60.00</p>
                  </div>
                  <div class="text-right">
                    <p class="text-sm text-gray-600 dark:text-gray-400" id="paraResultSecondaryLabel">Formula</p>
                    <p class="text-sm font-medium text-gray-700 dark:text-gray-300" id="paraResultFormula">A = b × h</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Formula & Explanation -->
        <div class="lg:col-span-2 space-y-4">
          <!-- Formula Card -->
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-3">📐 Formula</h3>
            <div class="bg-gray-100 dark:bg-gray-700 rounded-xl p-4 text-center">
              <p class="text-2xl font-mono text-gray-800 dark:text-gray-200" id="paraFormulaDisplay">A = b × h</p>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1" id="paraFormulaDesc">Area = Base × Height</p>
            </div>
            <div class="mt-4 space-y-2 text-sm text-gray-600 dark:text-gray-400">
              <div class="flex justify-between border-b border-gray-100 dark:border-gray-700 pb-2">
                <span id="paraFormulaLabel1">Base (b)</span>
                <span class="font-mono" id="paraFormulaVal1">10 cm</span>
              </div>
              <div class="flex justify-between border-b border-gray-100 dark:border-gray-700 pb-2">
                <span id="paraFormulaLabel2">Height (h)</span>
                <span class="font-mono" id="paraFormulaVal2">6 cm</span>
              </div>
              <div class="flex justify-between font-bold text-emerald-600 dark:text-emerald-400 pt-1">
                <span id="paraFormulaResultLabel">Area</span>
                <span class="font-mono" id="paraFormulaResult">60.00 cm²</span>
              </div>
            </div>
          </div>

          <!-- Step-by-Step Solution -->
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-3">📝 Step-by-Step</h3>
            <div id="paraStepsContainer" class="space-y-3 text-sm">
              <div class="flex items-start gap-3 p-2 rounded-lg bg-gray-50 dark:bg-gray-700/50">
                <span class="text-emerald-500 font-bold min-w-[24px]">1.</span>
                <span class="text-gray-600 dark:text-gray-400" id="paraStep1">Formula: A = b × h</span>
              </div>
              <div class="flex items-start gap-3 p-2 rounded-lg bg-gray-50 dark:bg-gray-700/50">
                <span class="text-emerald-500 font-bold min-w-[24px]">2.</span>
                <span class="text-gray-600 dark:text-gray-400" id="paraStep2">Plug in: A = 10 × 6</span>
              </div>
              <div class="flex items-start gap-3 p-2 rounded-lg bg-gray-50 dark:bg-gray-700/50">
                <span class="text-emerald-500 font-bold min-w-[24px]">3.</span>
                <span class="text-gray-600 dark:text-gray-400" id="paraStep3">Calculate: A = 60</span>
              </div>
              <div class="flex items-start gap-3 p-3 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800">
                <span class="text-emerald-600 dark:text-emerald-400 font-bold min-w-[24px]">✓</span>
                <span class="font-bold text-emerald-600 dark:text-emerald-400" id="paraStep4">Answer: A = 60.00 cm²</span>
              </div>
            </div>
          </div>

          <!-- Fun Facts -->
          <div class="space-y-3">
            <div class="bg-gradient-to-r from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20 rounded-2xl p-4 border border-amber-200 dark:border-amber-800">
              <p class="text-sm text-gray-700 dark:text-gray-300">
                💡 <span class="font-medium">Did you know?</span>
                A rectangle is a special type of parallelogram where all angles are 90°!
              </p>
            </div>
            <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-2xl p-4 border border-blue-200 dark:border-blue-800">
              <p class="text-sm text-gray-700 dark:text-gray-300">
                📐 <span class="font-medium">Fun Fact:</span>
                The opposite sides of a parallelogram are always parallel and equal in length!
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================ -->
      <!-- SEO CONTENT - USING THE COMPONENT            -->
      <!-- ============================================ -->
      <SEOContent 
        title="What is a Parallelogram Area Calculator?"
        description="A parallelogram area calculator is a tool that helps you find the area of a parallelogram quickly and accurately. Whether you're a student learning geometry, a teacher preparing lessons, or a professional needing quick calculations, this tool makes it easy."
        formula="A = b × h"
        formulaDescription="Where A = Area, b = Base, h = Height (perpendicular distance)"
        example={{
          title: "Example: Find the area of a parallelogram with base 10 cm and height 6 cm",
          steps: [
            "A = b × h",
            "A = 10 × 6"
          ],
          result: "A = 60 cm²"
        }}
        uses={[
          "Construction: Calculating floor areas for slanted walls and irregular spaces",
          "Engineering: Designing mechanical components with parallelogram shapes",
          "Architecture: Planning buildings with slanted or angled walls",
          "Gardening: Measuring irregular garden beds and plots",
          "Design: Creating patterns and geometric designs"
        ]}
        faqs={[
          {
            question: "What is the difference between a parallelogram and a rectangle?",
            answer: "A rectangle is a special type of parallelogram where all angles are 90°. In a general parallelogram, angles can be any value, but opposite angles are equal."
          },
          {
            question: "Why do we use the height, not the side length?",
            answer: "The height is the perpendicular distance between the base and the opposite side. This is because the area of a parallelogram can be found by cutting off a right triangle and moving it to the other side to form a rectangle."
          },
          {
            question: "What is a rhombus?",
            answer: "A rhombus is a special parallelogram where all four sides are equal in length. It's like a square that's been pushed over!"
          }
        ]}
      />

    </div>
  </main>

  <script>
   document.addEventListener('DOMContentLoaded', () => {
  // ============================================
  // STATE
  // ============================================
  let currentUnit = 'cm';
  let currentMode = 'area'; // 'area', 'base', 'height'
  let currentBase = 10;
  let currentHeight = 6;
  let currentSide = 8;

  // ============================================
  // DOM REFERENCES
  // ============================================
  // Area mode
  const baseSliderPara = document.getElementById('baseSliderPara');
  const heightSliderPara = document.getElementById('heightSliderPara');
  const sideSliderPara = document.getElementById('sideSliderPara');
  const baseInputPara = document.getElementById('baseInputPara');
  const heightInputPara = document.getElementById('heightInputPara');
  const sideInputPara = document.getElementById('sideInputPara');
  const baseDisplayPara = document.getElementById('baseDisplayPara');
  const heightDisplayPara = document.getElementById('heightDisplayPara');
  const sideDisplayPara = document.getElementById('sideDisplayPara');
  const baseUnitDisplayPara = document.getElementById('baseUnitDisplayPara');
  const heightUnitDisplayPara = document.getElementById('heightUnitDisplayPara');
  const sideUnitDisplayPara = document.getElementById('sideUnitDisplayPara');

  // Base mode
  const areaForBaseSlider = document.getElementById('areaForBaseSlider');
  const heightForBaseSlider = document.getElementById('heightForBaseSlider');
  const areaForBaseInput = document.getElementById('areaForBaseInput');
  const heightForBaseInput = document.getElementById('heightForBaseInput');
  const areaForBaseDisplay = document.getElementById('areaForBaseDisplay');
  const areaForBaseUnit = document.getElementById('areaForBaseUnit');
  const heightForBaseDisplay = document.getElementById('heightForBaseDisplay');
  const heightForBaseUnit = document.getElementById('heightForBaseUnit');
  const areaBaseMaxLabel = document.getElementById('areaBaseMaxLabel');

  // Height mode
  const areaForHeightSlider = document.getElementById('areaForHeightSlider');
  const baseForHeightSlider = document.getElementById('baseForHeightSlider');
  const areaForHeightInput = document.getElementById('areaForHeightInput');
  const baseForHeightInput = document.getElementById('baseForHeightInput');
  const areaForHeightDisplay = document.getElementById('areaForHeightDisplay');
  const areaForHeightUnit = document.getElementById('areaForHeightUnit');
  const baseForHeightDisplay = document.getElementById('baseForHeightDisplay');
  const baseForHeightUnit = document.getElementById('baseForHeightUnit');
  const areaHeightMaxLabel = document.getElementById('areaHeightMaxLabel');

  // SVG
  const paraVisual = document.getElementById('paraVisual');
  const heightLinePara = document.getElementById('heightLinePara');
  const baseLabelParaValue = document.getElementById('baseLabelParaValue');
  const heightLabelParaValue = document.getElementById('heightLabelParaValue');
  const sideLabelParaValue = document.getElementById('sideLabelParaValue');
  const areaLabelParaValue = document.getElementById('areaLabelParaValue');
  const paraResultValue = document.getElementById('paraResultValue');
  const paraResultLabel = document.getElementById('paraResultLabel');
  const paraResultSecondaryLabel = document.getElementById('paraResultSecondaryLabel');
  const paraResultFormula = document.getElementById('paraResultFormula');
  const paraFormulaDisplay = document.getElementById('paraFormulaDisplay');
  const paraFormulaDesc = document.getElementById('paraFormulaDesc');
  const paraFormulaLabel1 = document.getElementById('paraFormulaLabel1');
  const paraFormulaLabel2 = document.getElementById('paraFormulaLabel2');
  const paraFormulaVal1 = document.getElementById('paraFormulaVal1');
  const paraFormulaVal2 = document.getElementById('paraFormulaVal2');
  const paraFormulaResultLabel = document.getElementById('paraFormulaResultLabel');
  const paraFormulaResult = document.getElementById('paraFormulaResult');
  const paraStep1 = document.getElementById('paraStep1');
  const paraStep2 = document.getElementById('paraStep2');
  const paraStep3 = document.getElementById('paraStep3');
  const paraStep4 = document.getElementById('paraStep4');

  const paraAreaModeInputs = document.getElementById('paraAreaModeInputs');
  const paraBaseModeInputs = document.getElementById('paraBaseModeInputs');
  const paraHeightModeInputs = document.getElementById('paraHeightModeInputs');

  const unitConversions = {
    cm: { label: 'cm', factor: 1, display: 'cm' },
    m: { label: 'm', factor: 100, display: 'm' },
    in: { label: 'in', factor: 2.54, display: 'in' },
    ft: { label: 'ft', factor: 30.48, display: 'ft' }
  };

  // ============================================
  // VALIDATION HELPERS
  // ============================================
  function validatePositive(value, name) {
    if (value === '' || value === null || value === undefined) {
      return { valid: false, message: `Please enter a ${name}` };
    }
    const num = parseFloat(value);
    if (isNaN(num)) {
      return { valid: false, message: 'Please enter a valid number' };
    }
    if (num < 0) {
      return { valid: false, message: `${name} cannot be negative` };
    }
    if (num > 1e10) {
      return { valid: false, message: `${name} is too large` };
    }
    return { valid: true, value: num };
  }

  function getUnit() { return unitConversions[currentUnit]; }

  function formatArea(area) {
    let displayArea = area;
    let areaUnit = 'cm²';
    if (currentUnit === 'm') { displayArea = area / 10000; areaUnit = 'm²'; }
    else if (currentUnit === 'in') { displayArea = area / 6.4516; areaUnit = 'in²'; }
    else if (currentUnit === 'ft') { displayArea = area / 929.0304; areaUnit = 'ft²'; }
    return { value: displayArea, unit: areaUnit };
  }

  // ============================================
  // RESET FUNCTION
  // ============================================
  function resetParallelogram() {
    currentBase = 10;
    currentHeight = 6;
    currentSide = 8;
    baseSliderPara.value = 10;
    heightSliderPara.value = 6;
    sideSliderPara.value = 8;
    baseInputPara.value = 10;
    heightInputPara.value = 6;
    sideInputPara.value = 8;
    areaForBaseSlider.value = 60;
    areaForBaseInput.value = 60;
    heightForBaseSlider.value = 6;
    heightForBaseInput.value = 6;
    areaForHeightSlider.value = 60;
    areaForHeightInput.value = 60;
    baseForHeightSlider.value = 10;
    baseForHeightInput.value = 10;
    updateParallelogram();
    if (window.showToast) {
      window.showToast('🔄 Parallelogram calculator reset to default values', 'info');
    }
  }

  // ============================================
  // UPDATE SVG
  // ============================================
  function updateSVG(base, height, side, area) {
    const maxSize = Math.max(base, height, side, 20);
    const scaleBase = Math.min(base / maxSize, 1);
    const scaleHeight = Math.min(height / maxSize, 1);
    const scaleSide = Math.min(side / maxSize, 1);
    const centerX = 250;
    const topY = 100 + (1 - scaleHeight) * 150;
    const bottomY = 100 + (1 + scaleHeight) * 150;
    const baseWidth = 100 + scaleBase * 200;
    const slant = 50 + scaleSide * 100;
    const topLeftX = centerX - baseWidth / 2 + slant;
    const topRightX = centerX + baseWidth / 2 + slant;
    const bottomLeftX = centerX - baseWidth / 2;
    const bottomRightX = centerX + baseWidth / 2;

    paraVisual.setAttribute('points', 
      `${topLeftX},${topY} ${topRightX},${topY} ${bottomRightX},${bottomY} ${bottomLeftX},${bottomY}`
    );
    heightLinePara.setAttribute('x1', bottomLeftX);
    heightLinePara.setAttribute('y1', topY);
    heightLinePara.setAttribute('x2', bottomLeftX);
    heightLinePara.setAttribute('y2', bottomY);

    const formatted = formatArea(area);
    baseLabelParaValue.textContent = base.toFixed(2);
    heightLabelParaValue.textContent = height.toFixed(2);
    sideLabelParaValue.textContent = side.toFixed(2);
    areaLabelParaValue.textContent = formatted.value.toFixed(2);
  }

  // ============================================
  // UPDATE RESULT
  // ============================================
  function updateResult(value, label, secondary, formula) {
    paraResultValue.textContent = value;
    paraResultLabel.textContent = label;
    paraResultSecondaryLabel.textContent = secondary;
    paraResultFormula.textContent = formula;
  }

  function updateFormula(val1, val2, result, label1, label2, resultLabel, display, desc) {
    paraFormulaVal1.textContent = val1;
    paraFormulaVal2.textContent = val2;
    paraFormulaResult.textContent = result;
    paraFormulaLabel1.textContent = label1;
    paraFormulaLabel2.textContent = label2;
    paraFormulaResultLabel.textContent = resultLabel;
    if (display) paraFormulaDisplay.textContent = display;
    if (desc) paraFormulaDesc.textContent = desc;
  }

  function updateSteps(s1, s2, s3, s4) {
    paraStep1.textContent = s1;
    paraStep2.textContent = s2;
    paraStep3.textContent = s3;
    paraStep4.textContent = s4;
  }

  // ============================================
  // MODE TOGGLE
  // ============================================
  function setMode(mode) {
    currentMode = mode;
    document.querySelectorAll('.para-mode-btn').forEach(b => {
      b.className = 'para-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600';
    });
    const btnMap = { area: 'modeAreaPara', base: 'modeBasePara', height: 'modeHeightPara' };
    document.getElementById(btnMap[mode]).className = 'para-mode-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25';

    paraAreaModeInputs.classList.toggle('hidden', mode !== 'area');
    paraBaseModeInputs.classList.toggle('hidden', mode !== 'base');
    paraHeightModeInputs.classList.toggle('hidden', mode !== 'height');

    if (mode === 'area') {
      baseInputPara.value = baseSliderPara.value;
      heightInputPara.value = heightSliderPara.value;
      sideInputPara.value = sideSliderPara.value;
    } else if (mode === 'base') {
      areaForBaseInput.value = areaForBaseSlider.value;
      heightForBaseInput.value = heightForBaseSlider.value;
    } else if (mode === 'height') {
      areaForHeightInput.value = areaForHeightSlider.value;
      baseForHeightInput.value = baseForHeightSlider.value;
    }
    updateParallelogram();
  }

  document.getElementById('modeAreaPara').addEventListener('click', () => setMode('area'));
  document.getElementById('modeBasePara').addEventListener('click', () => setMode('base'));
  document.getElementById('modeHeightPara').addEventListener('click', () => setMode('height'));

  // ============================================
  // UNIT TOGGLE
  // ============================================
  document.querySelectorAll('.para-unit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.para-unit-btn').forEach(b => {
        b.className = 'para-unit-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600';
      });
      btn.className = 'para-unit-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-emerald-600 text-white shadow-lg shadow-emerald-500/25';
      currentUnit = btn.dataset.unit;
      const maxArea = 20 * 20;
      const formatted = formatArea(maxArea);
      areaBaseMaxLabel.textContent = formatted.value.toFixed(0);
      areaHeightMaxLabel.textContent = formatted.value.toFixed(0);
      updateParallelogram();
    });
  });

  // ============================================
  // UPDATE PARALLELOGRAM
  // ============================================
  function updateParallelogram() {
    const unit = getUnit();
    const displayUnit = unit.display;
    let base, height, side, area;
    let resultValue, resultLabel, resultSecondary, resultFormula;
    let formulaDisplay, formulaDesc, label1, label2, resultLabelText;
    let val1, val2, result;
    let step1, step2, step3, step4;

    if (currentMode === 'area') {
      base = parseFloat(baseSliderPara.value);
      height = parseFloat(heightSliderPara.value);
      side = parseFloat(sideSliderPara.value);
      area = base * height;

      const formatted = formatArea(area);
      resultValue = formatted.value.toFixed(2);
      resultLabel = 'Area of Parallelogram';
      resultSecondary = 'A = b × h';
      resultFormula = 'A = b × h';
      formulaDisplay = 'A = b × h';
      formulaDesc = 'Area = Base × Height';
      label1 = 'Base (b)';
      label2 = 'Height (h)';
      resultLabelText = 'Area';
      val1 = `${base} ${displayUnit}`;
      val2 = `${height} ${displayUnit}`;
      result = `${formatted.value.toFixed(2)} ${formatted.unit}`;
      step1 = 'Formula: A = b × h';
      step2 = `Plug in: A = ${base} × ${height}`;
      step3 = `Calculate: A = ${area.toFixed(2)}`;
      step4 = `Answer: A = ${formatted.value.toFixed(2)} ${formatted.unit}`;

      baseDisplayPara.textContent = base;
      heightDisplayPara.textContent = height;
      sideDisplayPara.textContent = side;
      baseUnitDisplayPara.textContent = displayUnit;
      heightUnitDisplayPara.textContent = displayUnit;
      sideUnitDisplayPara.textContent = displayUnit;

    } else if (currentMode === 'base') {
      const areaVal = parseFloat(areaForBaseSlider.value);
      height = parseFloat(heightForBaseSlider.value);
      let areaCm2 = areaVal;
      if (currentUnit === 'm') areaCm2 = areaVal * 10000;
      else if (currentUnit === 'in') areaCm2 = areaVal * 6.4516;
      else if (currentUnit === 'ft') areaCm2 = areaVal * 929.0304;
      base = areaCm2 / height;
      side = base;
      area = areaCm2;

      const formatted = formatArea(area);
      resultValue = base.toFixed(2);
      resultLabel = 'Base (b)';
      resultSecondary = 'b = A / h';
      resultFormula = 'b = A / h';
      formulaDisplay = 'b = A / h';
      formulaDesc = 'Base = Area ÷ Height';
      label1 = 'Area';
      label2 = 'Height (h)';
      resultLabelText = 'Base (b)';
      val1 = `${formatted.value.toFixed(2)} ${formatted.unit}`;
      val2 = `${height} ${displayUnit}`;
      result = `${base.toFixed(2)} ${displayUnit}`;
      step1 = 'Formula: b = A / h';
      step2 = `Plug in: b = ${formatted.value.toFixed(2)} ÷ ${height}`;
      step3 = `Calculate: b = ${base.toFixed(2)}`;
      step4 = `Answer: b = ${base.toFixed(2)} ${displayUnit}`;

      areaForBaseDisplay.textContent = formatted.value.toFixed(2);
      areaForBaseUnit.textContent = formatted.unit;
      heightForBaseDisplay.textContent = height;
      heightForBaseUnit.textContent = displayUnit;

    } else if (currentMode === 'height') {
      const areaVal = parseFloat(areaForHeightSlider.value);
      base = parseFloat(baseForHeightSlider.value);
      let areaCm2 = areaVal;
      if (currentUnit === 'm') areaCm2 = areaVal * 10000;
      else if (currentUnit === 'in') areaCm2 = areaVal * 6.4516;
      else if (currentUnit === 'ft') areaCm2 = areaVal * 929.0304;
      height = areaCm2 / base;
      side = height;
      area = areaCm2;

      const formatted = formatArea(area);
      resultValue = height.toFixed(2);
      resultLabel = 'Height (h)';
      resultSecondary = 'h = A / b';
      resultFormula = 'h = A / b';
      formulaDisplay = 'h = A / b';
      formulaDesc = 'Height = Area ÷ Base';
      label1 = 'Area';
      label2 = 'Base (b)';
      resultLabelText = 'Height (h)';
      val1 = `${formatted.value.toFixed(2)} ${formatted.unit}`;
      val2 = `${base} ${displayUnit}`;
      result = `${height.toFixed(2)} ${displayUnit}`;
      step1 = 'Formula: h = A / b';
      step2 = `Plug in: h = ${formatted.value.toFixed(2)} ÷ ${base}`;
      step3 = `Calculate: h = ${height.toFixed(2)}`;
      step4 = `Answer: h = ${height.toFixed(2)} ${displayUnit}`;

      areaForHeightDisplay.textContent = formatted.value.toFixed(2);
      areaForHeightUnit.textContent = formatted.unit;
      baseForHeightDisplay.textContent = base;
      baseForHeightUnit.textContent = displayUnit;
    }

    // Update SVG
    updateSVG(base, height, side || base, area);

    // Update result
    updateResult(resultValue, resultLabel, resultSecondary, resultFormula);

    // Update formula
    updateFormula(
      val1,
      val2,
      result,
      label1,
      label2,
      resultLabelText,
      formulaDisplay,
      formulaDesc
    );

    // Update steps
    updateSteps(step1, step2, step3, step4);

    // Update inputs
    if (currentMode === 'area') {
      baseInputPara.value = base;
      heightInputPara.value = height;
      sideInputPara.value = side || base;
    } else if (currentMode === 'base') {
      areaForBaseInput.value = areaForBaseSlider.value;
      heightForBaseInput.value = heightForBaseSlider.value;
    } else if (currentMode === 'height') {
      areaForHeightInput.value = areaForHeightSlider.value;
      baseForHeightInput.value = baseForHeightSlider.value;
    }
  }

  // ============================================
  // AREA MODE EVENTS
  // ============================================
  baseSliderPara.addEventListener('input', () => { if (currentMode === 'area') updateParallelogram(); });
  heightSliderPara.addEventListener('input', () => { if (currentMode === 'area') updateParallelogram(); });
  sideSliderPara.addEventListener('input', () => { if (currentMode === 'area') updateParallelogram(); });

  baseInputPara.addEventListener('input', () => {
    if (currentMode === 'area') {
      const validation = validatePositive(baseInputPara.value, 'Base');
      if (validation.valid) {
        baseSliderPara.value = Math.min(validation.value, 20);
        updateParallelogram();
      }
    }
  });
  heightInputPara.addEventListener('input', () => {
    if (currentMode === 'area') {
      const validation = validatePositive(heightInputPara.value, 'Height');
      if (validation.valid) {
        heightSliderPara.value = Math.min(validation.value, 20);
        updateParallelogram();
      }
    }
  });
  sideInputPara.addEventListener('input', () => {
    if (currentMode === 'area') {
      const validation = validatePositive(sideInputPara.value, 'Side');
      if (validation.valid) {
        sideSliderPara.value = Math.min(validation.value, 20);
        updateParallelogram();
      }
    }
  });

  document.getElementById('paraCalculateBtn').addEventListener('click', () => {
    if (currentMode === 'area') {
      const bVal = validatePositive(baseInputPara.value, 'Base');
      const hVal = validatePositive(heightInputPara.value, 'Height');
      const sVal = validatePositive(sideInputPara.value, 'Side');
      if (!bVal.valid) { alert(bVal.message); baseInputPara.focus(); return; }
      if (!hVal.valid) { alert(hVal.message); heightInputPara.focus(); return; }
      if (!sVal.valid) { alert(sVal.message); sideInputPara.focus(); return; }
      baseSliderPara.value = Math.min(bVal.value, 20);
      heightSliderPara.value = Math.min(hVal.value, 20);
      sideSliderPara.value = Math.min(sVal.value, 20);
      updateParallelogram();
      if (window.showToast) {
        window.showToast('✅ Calculation updated!', 'success');
      }
    }
  });

  // ============================================
  // BASE MODE EVENTS
  // ============================================
  areaForBaseSlider.addEventListener('input', () => { if (currentMode === 'base') updateParallelogram(); });
  heightForBaseSlider.addEventListener('input', () => { if (currentMode === 'base') updateParallelogram(); });

  areaForBaseInput.addEventListener('input', () => {
    if (currentMode === 'base') {
      const validation = validatePositive(areaForBaseInput.value, 'Area');
      if (validation.valid) { areaForBaseSlider.value = validation.value; updateParallelogram(); }
    }
  });
  heightForBaseInput.addEventListener('input', () => {
    if (currentMode === 'base') {
      const validation = validatePositive(heightForBaseInput.value, 'Height');
      if (validation.valid) { heightForBaseSlider.value = validation.value; updateParallelogram(); }
    }
  });

  document.getElementById('findBaseParaBtn').addEventListener('click', () => {
    if (currentMode === 'base') {
      const aVal = validatePositive(areaForBaseInput.value, 'Area');
      const hVal = validatePositive(heightForBaseInput.value, 'Height');
      if (!aVal.valid) { alert(aVal.message); areaForBaseInput.focus(); return; }
      if (!hVal.valid) { alert(hVal.message); heightForBaseInput.focus(); return; }
      areaForBaseSlider.value = aVal.value;
      heightForBaseSlider.value = hVal.value;
      updateParallelogram();
      if (window.showToast) {
        window.showToast('✅ Base found!', 'success');
      }
    }
  });

  // ============================================
  // HEIGHT MODE EVENTS
  // ============================================
  areaForHeightSlider.addEventListener('input', () => { if (currentMode === 'height') updateParallelogram(); });
  baseForHeightSlider.addEventListener('input', () => { if (currentMode === 'height') updateParallelogram(); });

  areaForHeightInput.addEventListener('input', () => {
    if (currentMode === 'height') {
      const validation = validatePositive(areaForHeightInput.value, 'Area');
      if (validation.valid) { areaForHeightSlider.value = validation.value; updateParallelogram(); }
    }
  });
  baseForHeightInput.addEventListener('input', () => {
    if (currentMode === 'height') {
      const validation = validatePositive(baseForHeightInput.value, 'Base');
      if (validation.valid) { baseForHeightSlider.value = validation.value; updateParallelogram(); }
    }
  });

  document.getElementById('findHeightParaBtn').addEventListener('click', () => {
    if (currentMode === 'height') {
      const aVal = validatePositive(areaForHeightInput.value, 'Area');
      const bVal = validatePositive(baseForHeightInput.value, 'Base');
      if (!aVal.valid) { alert(aVal.message); areaForHeightInput.focus(); return; }
      if (!bVal.valid) { alert(bVal.message); baseForHeightInput.focus(); return; }
      areaForHeightSlider.value = aVal.value;
      baseForHeightSlider.value = bVal.value;
      updateParallelogram();
      if (window.showToast) {
        window.showToast('✅ Height found!', 'success');
      }
    }
  });

  // ============================================
  // RESET BUTTON
  // ============================================
  const resetBtn = document.createElement('button');
  resetBtn.id = 'resetParaBtn';
  resetBtn.className = 'btn-secondary w-full mt-3 text-center';
  resetBtn.textContent = '🔄 Reset Calculator';
  resetBtn.addEventListener('click', resetParallelogram);
  
  const resultBox = document.getElementById('paraResultBox');
  if (resultBox) {
    resultBox.parentNode.insertBefore(resetBtn, resultBox.nextSibling);
  }

  // ============================================
  // KEYBOARD SHORTCUT: Ctrl+Shift+R to reset
  // ============================================
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key === 'R') {
      e.preventDefault();
      resetParallelogram();
    }
  });

  // ============================================
  // INITIALIZE
  // ============================================
  const maxArea = 20 * 20;
  const formatted = formatArea(maxArea);
  areaBaseMaxLabel.textContent = formatted.value.toFixed(0);
  areaHeightMaxLabel.textContent = formatted.value.toFixed(0);
  updateParallelogram();
});
  </script>
</Layout>