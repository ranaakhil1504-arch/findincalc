---
// src/pages/math/index.astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { getCalculatorsByCategory, getCategoryCount } from '../../data/calculators';

// Get all math calculators from the central registry
const mathCalculators = getCalculatorsByCategory('math');
const totalMathCount = getCategoryCount('math');
---

<Layout title="Math Calculators - Geometry, Algebra, and More">
  <Navbar />

  <main class="pt-8 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12 fade-in">
        <span class="text-5xl">📐</span>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mt-2">
          Math Calculators
        </h1>
        <p class="text-gray-600 dark:text-gray-400">
          {totalMathCount} free online math calculators
        </p>
        <div class="w-20 h-1 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full mx-auto mt-4"></div>
      </div>

      <!-- Area Calculators Section -->
      <div class="mb-12">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
          <span>📏 Area Calculators</span>
          <span class="text-xs bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 px-2 py-0.5 rounded-full">
            {mathCalculators.filter(c => c.id.includes('area')).length} tools
          </span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {mathCalculators
            .filter(c => c.id.includes('area'))
            .map((calc) => {
              const colorMap: Record<string, string> = {
                'circle-area': 'emerald',
                'rectangle-area': 'blue',
                'triangle-area': 'orange',
                'trapezoid-area': 'purple',
                'parallelogram-area': 'red',
                'ellipse-area': 'pink'
              };
              const colors: Record<string, string> = {
                emerald: 'hover:border-emerald-300 dark:hover:border-emerald-700',
                blue: 'hover:border-blue-300 dark:hover:border-blue-700',
                orange: 'hover:border-orange-300 dark:hover:border-orange-700',
                purple: 'hover:border-purple-300 dark:hover:border-purple-700',
                red: 'hover:border-red-300 dark:hover:border-red-700',
                pink: 'hover:border-pink-300 dark:hover:border-pink-700'
              };
              return (
                <a
                  href={calc.url}
                  class={`group bg-white dark:bg-gray-800 rounded-xl p-4 shadow-md hover:shadow-xl transition-all duration-300 border-2 border-gray-100 dark:border-gray-700 ${colors[colorMap[calc.id] || 'emerald']} card-hover`}
                >
                  <div class="flex items-center space-x-4">
                    <span class="text-3xl">{calc.icon}</span>
                    <div>
                      <h3 class="font-semibold text-gray-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                        {calc.name}
                      </h3>
                      <p class="text-sm text-gray-500 dark:text-gray-400 font-mono">{calc.formula || calc.description}</p>
                    </div>
                  </div>
                </a>
              );
            })}
        </div>
      </div>

      <!-- Volume Calculators Section -->
      <div class="mb-12">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
          <span>🧊 Volume Calculators</span>
          <span class="text-xs bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 px-2 py-0.5 rounded-full">
            Coming Soon
          </span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            { name: "Sphere Volume", icon: "⚽", desc: "V = ⁴⁄₃πr³" },
            { name: "Cube Volume", icon: "🧊", desc: "V = s³" },
            { name: "Cylinder Volume", icon: "🥫", desc: "V = πr²h" },
            { name: "Cone Volume", icon: "🍦", desc: "V = ⅓πr²h" },
            { name: "Rectangular Prism", icon: "📦", desc: "V = l × w × h" },
            { name: "Pyramid Volume", icon: "🔺", desc: "V = ⅓Bh" },
          ].map((item) => (
            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 border-2 border-dashed border-gray-300 dark:border-gray-700 opacity-60">
              <div class="flex items-center space-x-4">
                <span class="text-3xl">{item.icon}</span>
                <div>
                  <h3 class="font-semibold text-gray-500 dark:text-gray-400">{item.name}</h3>
                  <p class="text-sm text-gray-400 dark:text-gray-500 font-mono">{item.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- All Math Calculators -->
      <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
          <span>📊 All Math Calculators</span>
          <span class="text-xs bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 px-2 py-0.5 rounded-full">
            {totalMathCount} tools
          </span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {mathCalculators.map((calc) => {
            const colorMap: Record<string, string> = {
              'circle-area': 'emerald',
              'rectangle-area': 'blue',
              'triangle-area': 'orange',
              'trapezoid-area': 'purple',
              'parallelogram-area': 'red',
              'ellipse-area': 'pink'
            };
            const colors: Record<string, string> = {
              emerald: 'hover:border-emerald-300 dark:hover:border-emerald-700',
              blue: 'hover:border-blue-300 dark:hover:border-blue-700',
              orange: 'hover:border-orange-300 dark:hover:border-orange-700',
              purple: 'hover:border-purple-300 dark:hover:border-purple-700',
              red: 'hover:border-red-300 dark:hover:border-red-700',
              pink: 'hover:border-pink-300 dark:hover:border-pink-700'
            };
            return (
              <a
                href={calc.url}
                class={`group bg-white dark:bg-gray-800 rounded-xl p-4 shadow-md hover:shadow-xl transition-all duration-300 border-2 border-gray-100 dark:border-gray-700 ${colors[colorMap[calc.id] || 'emerald']} card-hover`}
              >
                <div class="flex items-center space-x-4">
                  <span class="text-3xl">{calc.icon}</span>
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                      {calc.name}
                    </h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">{calc.description}</p>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </main>
</Layout>