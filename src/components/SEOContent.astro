---
// src/components/SEOContent.astro
export interface Props {
  title: string;
  description?: string;
  formula?: string;
  formulaDescription?: string;
  example?: {
    title?: string;
    steps?: string[];
    result?: string;
  };
  uses?: string[];
  faqs?: Array<{ question: string; answer: string }>;
  note?: string;
  customContent?: string;
}

const {
  title,
  description,
  formula,
  formulaDescription,
  example,
  uses = [],
  faqs = [],
  note,
  customContent
} = Astro.props;
---

<div class="mt-16 max-w-4xl mx-auto">
  <!-- Section Divider -->
  <div class="relative mb-12">
    <div class="absolute inset-0 flex items-center">
      <div class="w-full border-t border-gray-200 dark:border-gray-700"></div>
    </div>
    <div class="relative flex justify-center">
      <span class="bg-white dark:bg-gray-800 px-6 py-2 rounded-full text-sm font-medium text-emerald-600 dark:text-emerald-400 border border-gray-200 dark:border-gray-700">
        📖 Learn More
      </span>
    </div>
  </div>

  <div class="prose prose-emerald dark:prose-invert max-w-none">
    <!-- Title -->
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
      {title}
    </h2>

    <!-- Description -->
    {description && (
      <p class="text-gray-600 dark:text-gray-300 text-base leading-relaxed">
        {description}
      </p>
    )}

    <!-- Formula -->
    {formula && (
      <div class="my-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-3">
          Formula
        </h3>
        <div class="bg-gray-100 dark:bg-gray-700/50 rounded-xl p-6 text-center border border-gray-200 dark:border-gray-600">
          <p class="text-2xl font-mono text-gray-800 dark:text-gray-200 font-bold">
            {formula}
          </p>
          {formulaDescription && (
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
              {formulaDescription}
            </p>
          )}
        </div>
      </div>
    )}

    <!-- Example -->
    {example && (
      <div class="my-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-3">
          Example
        </h3>
        <div class="bg-gradient-to-r from-emerald-50 to-teal-50 dark:from-emerald-900/20 dark:to-teal-900/20 rounded-xl p-6 border border-emerald-200 dark:border-emerald-800">
          {example.title && (
            <p class="font-semibold text-gray-800 dark:text-gray-200">
              {example.title}
            </p>
          )}
          <div class="mt-3 space-y-1 font-mono text-sm text-gray-700 dark:text-gray-300">
            {example.steps?.map((step) => (
              <p key={step}>{step}</p>
            ))}
          </div>
          {example.result && (
            <p class="mt-3 font-bold text-emerald-600 dark:text-emerald-400 text-lg">
              {example.result}
            </p>
          )}
        </div>
      </div>
    )}

    <!-- Common Uses -->
    {uses.length > 0 && (
      <div class="my-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-3">
          Common Uses
        </h3>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {uses.map((use) => (
            <li key={use} class="flex items-start gap-2 text-gray-600 dark:text-gray-300 text-sm">
              <span class="text-emerald-500 mt-0.5">▸</span>
              {use}
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- FAQs -->
    {faqs.length > 0 && (
      <div class="my-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-3">
          Frequently Asked Questions
        </h3>
        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <div key={index} class="bg-gray-50 dark:bg-gray-700/30 rounded-xl p-4 border border-gray-200 dark:border-gray-600">
              <h4 class="font-semibold text-gray-800 dark:text-gray-200 text-sm">
                {faq.question}
              </h4>
              <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Note / Disclaimer -->
    {note && (
      <div class="my-6 p-4 rounded-xl bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800">
        <p class="text-sm text-gray-600 dark:text-gray-300">
          ⚠️ {note}
        </p>
      </div>
    )}

    <!-- Custom Content -->
    {customContent && (
      <div class="my-6" set:html={customContent} />
    )}
  </div>
</div>