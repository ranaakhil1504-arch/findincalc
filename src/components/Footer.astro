---
// src/components/Footer.astro
---

<footer class="bg-gray-900 dark:bg-gray-950 text-gray-300 border-t border-gray-800 dark:border-gray-800">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Column 1: Brand -->
      <div>
        <div class="flex items-center space-x-2 mb-4">
          <span class="text-2xl font-extrabold bg-gradient-to-r from-emerald-400 to-teal-400 bg-clip-text text-transparent">
            FindInCalc
          </span>
          <span class="text-xs font-medium bg-emerald-900/30 text-emerald-400 px-2 py-0.5 rounded-full">
            BETA
          </span>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed max-w-xs">
          Your all-in-one calculator hub. From math to health, finance to conversion — find every tool you need in one place.
        </p>
        <div class="flex space-x-4 mt-4">
          <a href="#" class="text-gray-500 hover:text-emerald-400 transition-colors text-xl" aria-label="Twitter">
            🐦
          </a>
          <a href="#" class="text-gray-500 hover:text-emerald-400 transition-colors text-xl" aria-label="Facebook">
            📘
          </a>
          <a href="#" class="text-gray-500 hover:text-emerald-400 transition-colors text-xl" aria-label="Instagram">
            📸
          </a>
          <a href="#" class="text-gray-500 hover:text-emerald-400 transition-colors text-xl" aria-label="GitHub">
            🐙
          </a>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/" class="text-gray-400 hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="text-emerald-500">›</span> Home
            </a>
          </li>
          <li>
            <a href="/math" class="text-gray-400 hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="text-emerald-500">›</span> Math Calculators
            </a>
          </li>
          <li>
            <a href="/health" class="text-gray-400 hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="text-emerald-500">›</span> Health Calculators
            </a>
          </li>
          <li>
            <a href="/finance" class="text-gray-400 hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="text-emerald-500">›</span> Finance Calculators
            </a>
          </li>
          <li>
            <a href="/conversion" class="text-gray-400 hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="text-emerald-500">›</span> Conversion Tools
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Support -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Support</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/faq" class="text-gray-400 hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="text-emerald-500">›</span> FAQ
            </a>
          </li>
          <li>
            <a href="/blog" class="text-gray-400 hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="text-emerald-500">›</span> Blog
            </a>
          </li>
          <li>
            <a href="/about" class="text-gray-400 hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="text-emerald-500">›</span> About Us
            </a>
          </li>
          <li>
            <a href="/contact" class="text-gray-400 hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="text-emerald-500">›</span> Contact
            </a>
          </li>
          <li>
            <a href="/privacy" class="text-gray-400 hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="text-emerald-500">›</span> Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="text-gray-400 hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="text-emerald-500">›</span> Terms of Service
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Newsletter / Stats -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Quick Stats</h3>
        <div class="space-y-3">
          <div class="bg-gray-800/50 rounded-lg p-3 border border-gray-700/50">
            <p class="text-2xl font-bold text-emerald-400">50+</p>
            <p class="text-xs text-gray-400">Free Calculators</p>
          </div>
          <div class="bg-gray-800/50 rounded-lg p-3 border border-gray-700/50">
            <p class="text-2xl font-bold text-emerald-400">12</p>
            <p class="text-xs text-gray-400">Categories</p>
          </div>
          <div class="bg-gray-800/50 rounded-lg p-3 border border-gray-700/50">
            <p class="text-2xl font-bold text-emerald-400">100%</p>
            <p class="text-xs text-gray-400">Free to Use</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-gray-800/50 my-8"></div>

    <!-- Bottom Bar -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-500">
        © 2026 <span class="text-emerald-400 font-medium">FindInCalc.com</span>. All rights reserved.
      </p>
      <div class="flex flex-wrap items-center gap-4 text-xs">
        <a href="/privacy" class="text-gray-500 hover:text-emerald-400 transition-colors">Privacy</a>
        <span class="text-gray-700">•</span>
        <a href="/terms" class="text-gray-500 hover:text-emerald-400 transition-colors">Terms</a>
        <span class="text-gray-700">•</span>
        <a href="/contact" class="text-gray-500 hover:text-emerald-400 transition-colors">Contact</a>
        <span class="text-gray-700">•</span>
        <span class="text-gray-600">Made with ❤️</span>
      </div>
    </div>
  </div>
</footer>